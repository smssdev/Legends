{
  "name": "legends-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "tokens": "node scripts/tokens.mjs",
    "predev": "npm run tokens && npm run names",
    "dev": "vite",
    "prebuild": "npm run tokens && npm run names && npm run i18n && npm run frames",
    "build": "vue-tsc -b && vite build",
    "postbuild": "node --experimental-strip-types --no-warnings scripts/seo.mjs",
    "preview": "vite preview",
    "api": "openapi-typescript ../docs/api/openapi.yaml -o src/api/schema.d.ts",
    "names": "node scripts/names.mjs",
    "i18n": "node scripts/i18n.mjs",
    "frames": "node --experimental-strip-types --no-warnings scripts/frames.mjs"
  },
  "dependencies": {
    "@headlessui/vue": "^1.7.23",
    "laravel-echo": "^2.6.1",
    "openapi-fetch": "^0.13.8",
    "pinia": "^3.0.4",
    "pusher-js": "^8.6.0",
    "reka-ui": "^2.10.5",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/tsconfig": "^0.7.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vue-tsc": "^2.2.8"
  }
}
