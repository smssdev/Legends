{
  "name": "legends-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "tokens": "node scripts/tokens.mjs",
    "predev": "npm run tokens && npm run nav && npm run names",
    "dev": "vite",
    "prebuild": "npm run tokens && npm run nav && npm run names && npm run i18n && npm run design && node scripts/safe-html.mjs && npm run frames && npm run feed && npm test",
    "build": "vue-tsc -b && vite build",
    "postbuild": "node scripts/sw.mjs && node scripts/budget.mjs && node --experimental-strip-types --no-warnings scripts/seo.mjs",
    "preview": "vite preview",
    "api": "openapi-typescript ../docs/api/openapi.yaml -o src/api/schema.d.ts",
    "names": "node scripts/names.mjs",
    "i18n": "node scripts/i18n.mjs && node scripts/story-words.mjs",
    "design": "node scripts/design.mjs",
    "frames": "node --experimental-strip-types --no-warnings scripts/frames.mjs",
    "feed": "node --experimental-strip-types --no-warnings scripts/feed.mjs",
    "e2e": "playwright test",
    "test": "vitest run",
    "nav": "node scripts/nav.mjs"
  },
  "dependencies": {
    "laravel-echo": "^2.6.1",
    "openapi-fetch": "^0.13.8",
    "pinia": "^3.0.4",
    "pusher-js": "^8.6.0",
    "reka-ui": "^2.10.5",
    "vue": "^3.5.13",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/tsconfig": "^0.7.0",
    "happy-dom": "^17.4.4",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.2.8"
  }
}
