{"هَجْمَةٌ خَطِيرَة...":[0.0,1.151],"اِنْطِلاقَةٌ سَرِيعَةٌ نَحْوَ المَرْمَى...":[1.302,2.092],"الكُرَةُ تَقْتَرِبُ مِنْ مَنْطِقَةِ الجَزَاء...":[3.543,3.121],"!جُووول! هَدَفٌ رائِع!":[6.814,3.1],"!هَدَف! الكُرَةُ فِي الشِّبَاك!":[10.064,3.119],"!يا سَلام! هَدَفٌ خُرافِيّ!":[13.333,2.982],"المُدَرَّجاتُ تَشْتَعِلُ فَرَحاً!":[16.465,2.942],"أَيُّ هَدَفٍ هٰذا!":[19.557,1.009],"هَدَفٌ يَسْتَحِقُّ التَّصْفِيق!":[20.716,1.609],"عَرْضِيَّةٌ داخِلَ المَنْطِقَة...":[22.474,2.13],"الكُرَةُ تَرْتَفِعُ داخِلَ الصُّنْدُوق...":[24.754,2.817],"!هَدَف! رَأْسِيَّةٌ قَوِيَّةٌ فِي الشِّبَاك!":[27.721,2.773],"!هَدَفٌ بِرَأْسِيَّةٍ رائِعَة!":[30.645,2.218],"لا أَحَدَ يُوقِفُهُ فِي الهَواء!":[33.013,2.057],"اِرْتِقاءٌ رائِع!":[35.219,1.269],"ضَرْبَةٌ حُرَّةٌ عَلَى حُدُودِ المَنْطِقَة.":[36.639,2.901],"الحائِطُ يَتَشَكَّل... والجَمِيعُ يَنْتَظِر.":[39.689,3.186],"!فَوْقَ الحائِطِ وَفِي الزّاوِيَة! هَدَفٌ مُذْهِل!":[43.026,5.006],"!هَدَفٌ مِنْ ضَرْبَةٍ حُرَّة! لَوْحَةٌ فَنِّيَّة!":[48.181,3.432],"الحارِسُ لَمْ يَتَحَرَّك!":[51.763,1.484],"تَسْدِيدَةٌ لا تُصَدّ!":[53.397,1.382],"!فَوْقَ الحائِط... والحارِسُ يَطِيرُ وَيُبْعِدُها!":[54.929,3.844],"!تَصَدٍّ رائِعٌ لِلضَّرْبَةِ الحُرَّة!":[58.923,2.181],"كادَتْ أَنْ تَكُونَ هَدَفاً!":[61.254,1.822],"قَرِيبَةٌ جِدّاً!":[63.226,0.943],"!فَوْقَ العارِضَة!":[64.319,1.254],"!بِجانِبِ القائِم!":[65.723,1.602],"فُرْصَةٌ ضائِعَة.":[67.475,0.847],"رَكْلَةُ جَزاء! الحَكَمُ يُشِيرُ إِلَى النُّقْطَة!":[68.472,4.002],"المَلْعَبُ يَحْبِسُ أَنْفاسَه...":[72.624,1.911],"!هَدَف! الحارِسُ فِي جِهَة، والكُرَةُ فِي جِهَة!":[74.685,4.21],"!هَدَف! تَسْدِيدَةٌ واثِقَة!":[79.046,2.844],"أَعْصابٌ مِنْ حَدِيد!":[82.04,1.399],"!تَصَدَّى! الحارِسُ يَقْرَؤُها!":[83.589,3.296],"!يا لَلرَّوْعَة! الحارِسُ يَصُدُّ رَكْلَةَ الجَزاء!":[87.035,4.506],"لَحْظَةٌ كَبِيرَةٌ فِي المُباراة!":[91.691,1.491],"اِنْفِرادٌ بِالمَرْمَى!":[93.332,1.713],"تَسْدِيدَةٌ قَوِيَّة...":[95.195,1.139],"فُرْصَةٌ خَطِيرَة!":[96.483,0.982],"!تَصَدٍّ رائِعٌ مِنَ الحارِس!":[97.615,2.188],"!الحارِسُ يَطِيرُ وَيُبْعِدُها!":[99.953,1.949],"حارِسٌ عالَمِيّ!":[102.052,1.77],"إِنْقاذٌ يُساوِي هَدَفاً!":[103.972,1.848],"تَسْدِيدَة...":[105.97,0.757],"مُحاوَلَةٌ عَلَى المَرْمَى...":[106.878,2.458],"!كادَتْ أَنْ تَكُونَ هَدَفاً!":[109.486,1.318],"المُدَرِّبُ لا يُصَدِّق!":[110.954,1.417],"فُرْصَةٌ لا تَتَكَرَّرُ كَثِيراً!":[112.521,2.339],"!القائِم! القائِمُ يَرُدُّ الكُرَة!":[115.01,2.862],"سَنْتِيمِتْراتٌ حَرَمَتْهُ مِنَ الهَدَف!":[118.023,2.325],"مُحاوَلَةٌ قَوِيَّة...":[120.498,2.104],"!الدِّفاعُ يَصُدّ!":[122.752,2.027],"!تَدَخُّلٌ شُجاعٌ مِنَ المُدافِع!":[124.929,1.987],"دِفاعٌ رائِع.":[127.066,1.039],"كُرَةٌ طَوِيلَةٌ خَلْفَ الدِّفاع...":[128.255,2.156],"الرّايَةُ مَرْفُوعَة. تَسَلُّل.":[130.56,2.992],"لا! تَسَلُّل.":[133.703,1.473],"تَقَدَّمَ بِخُطْوَةٍ قَبْلَ التَّمْرِير.":[135.326,3.406],"رُكْنِيَّة.":[138.882,0.544],"العَرْضِيَّةُ تَرْتَفِع...":[139.575,2.086],"!رَأْسِيَّة! فَوْقَ العارِضَةِ بِقَلِيل!":[141.811,2.315],"!رَأْسِيَّةٌ قَرِيبَةٌ جِدّاً!":[144.276,2.049],"كادَتِ الرُّكْنِيَّةُ أَنْ تُثْمِر.":[146.475,2.015],"الحارِسُ يُمْسِكُ الكُرَةَ بِثَبات.":[148.641,2.271],"زالَ الخَطَر.":[151.062,1.599],"تَدَخُّلٌ مُتَأَخِّر!":[152.811,1.162],"تَدَخُّلٌ قَوِيّ!":[154.123,1.122],"بِطاقَةٌ صَفْراء.":[155.395,1.064],"الحَكَمُ يُشْهِرُ البِطاقَةَ الصَّفْراء.":[156.609,2.647],"عَلَيْهِ الحَذَرُ مِنَ الآن.":[159.406,1.643],"تَدَخُّلٌ عَنِيفٌ مِنَ الخَلْف!":[161.199,2.404],"تَدَخُّلٌ خَطِير!":[163.753,1.188],"!بِطاقَةٌ حَمْراء! طَرْد!":[165.091,2.138],"!الحَكَمُ يَطْرُدُهُ مُباشَرَة!":[167.379,2.139],"فَرِيقُهُ يُكْمِلُ بِعَشَرَةِ لاعِبِين!":[169.668,1.616],"خُرُوجٌ حَزِينٌ إِلَى غُرْفَةِ المَلابِس.":[171.434,3.121],"تَدَخُّلٌ مُتَأَخِّرٌ آخَر...":[174.705,1.478],"!الإِنْذارُ الثّانِي! طَرْد!":[176.333,2.355],"لا يَلُومُ إِلّا نَفْسَه.":[178.838,1.48],"تَبْدِيل.":[180.468,0.82],"تَغْيِيرٌ فِي صُفُوفِ الفَرِيق.":[181.438,1.154],"دِماءٌ جَدِيدَة.":[182.742,1.746],"لاعِبٌ عَلَى الأَرْض.":[184.637,2.355],"إِصابَة... والجِهازُ الطِّبِّيُّ يَدْخُل.":[187.143,2.975],"نَتَمَنَّى أَلّا تَكُونَ خَطِيرَة.":[190.268,2.844],"المُدَرِّبُ يُعْطِي تَعْلِيماتٍ جَدِيدَة.":[193.262,3.027],"تَغْيِيرٌ تَكْتِيكِيٌّ مِنَ الدَّكَّة.":[196.438,1.807],"لِنَرَ إِنْ كانَ سَيُغَيِّرُ شَيْئاً.":[198.395,2.162],"اِنْطَلَقَتِ المُباراة!":[200.707,0.966],"!نِهايَةُ الشَّوْطِ الأَوَّل.":[201.823,1.732],"!صافِرَةُ النِّهايَة!":[203.705,1.499],"!إِلَى الوَقْتِ الإِضافِيّ!":[205.354,1.939],"!إِلَى رَكَلاتِ التَّرْجِيح!":[207.444,1.661],"وَقْتٌ بَدَلٌ ضائِع.":[209.255,1.696],"!رَكَلاتُ التَّرْجِيح... أَعْصابٌ مِنْ حَدِيد.":[211.101,3.49],"هَجْمَةٌ مُنَظَّمَة.":[214.741,1.193],"ضَغْطٌ مُتَواصِل.":[216.083,1.473],"مُحاوَلَةٌ لِبِناءِ الهَجْمَة.":[217.707,1.732]}