{"هَجْمَةٌ خَطِيرَة...":[0.0,1.647],"اِنْطِلاقَةٌ سَرِيعَةٌ نَحْوَ المَرْمَى...":[1.797,1.896],"الكُرَةُ تَقْتَرِبُ مِنْ مَنْطِقَةِ الجَزَاء...":[3.843,2.701],"!جُووول! هَدَفٌ رائِع!":[6.694,2.635],"!هَدَف! الكُرَةُ فِي الشِّبَاك!":[9.479,3.086],"!يا سَلام! هَدَفٌ خُرافِيّ!":[12.715,2.603],"المُدَرَّجاتُ تَشْتَعِلُ فَرَحاً!":[15.468,2.243],"أَيُّ هَدَفٍ هٰذا!":[17.861,1.612],"هَدَفٌ يَسْتَحِقُّ التَّصْفِيق!":[19.623,1.941],"عَرْضِيَّةٌ داخِلَ المَنْطِقَة...":[21.714,1.801],"الكُرَةُ تَرْتَفِعُ داخِلَ الصُّنْدُوق...":[23.665,2.03],"!هَدَف! رَأْسِيَّةٌ قَوِيَّةٌ فِي الشِّبَاك!":[25.845,2.73],"!هَدَفٌ بِرَأْسِيَّةٍ رائِعَة!":[28.725,2.05],"لا أَحَدَ يُوقِفُهُ فِي الهَواء!":[30.925,2.277],"اِرْتِقاءٌ رائِع!":[33.352,1.486],"ضَرْبَةٌ حُرَّةٌ عَلَى حُدُودِ المَنْطِقَة.":[34.989,2.166],"الحائِطُ يَتَشَكَّل... والجَمِيعُ يَنْتَظِر.":[37.305,3.253],"!فَوْقَ الحائِطِ وَفِي الزّاوِيَة! هَدَفٌ مُذْهِل!":[40.709,3.578],"!هَدَفٌ مِنْ ضَرْبَةٍ حُرَّة! لَوْحَةٌ فَنِّيَّة!":[44.436,2.934],"الحارِسُ لَمْ يَتَحَرَّك!":[47.52,2.248],"تَسْدِيدَةٌ لا تُصَدّ!":[49.918,1.889],"!فَوْقَ الحائِط... والحارِسُ يَطِيرُ وَيُبْعِدُها!":[51.957,3.27],"!تَصَدٍّ رائِعٌ لِلضَّرْبَةِ الحُرَّة!":[55.377,1.673],"كادَتْ أَنْ تَكُونَ هَدَفاً!":[57.199,1.345],"قَرِيبَةٌ جِدّاً!":[58.694,1.047],"!فَوْقَ العارِضَة!":[59.891,1.495],"!بِجانِبِ القائِم!":[61.535,1.459],"فُرْصَةٌ ضائِعَة.":[63.144,1.308],"رَكْلَةُ جَزاء! الحَكَمُ يُشِيرُ إِلَى النُّقْطَة!":[64.602,3.9],"المَلْعَبُ يَحْبِسُ أَنْفاسَه...":[68.652,2.576],"!هَدَف! الحارِسُ فِي جِهَة، والكُرَةُ فِي جِهَة!":[71.378,3.449],"!هَدَف! تَسْدِيدَةٌ واثِقَة!":[74.977,2.384],"أَعْصابٌ مِنْ حَدِيد!":[77.512,1.322],"!تَصَدَّى! الحارِسُ يَقْرَؤُها!":[78.984,2.883],"!يا لَلرَّوْعَة! الحارِسُ يَصُدُّ رَكْلَةَ الجَزاء!":[82.017,4.883],"لَحْظَةٌ كَبِيرَةٌ فِي المُباراة!":[87.05,1.987],"اِنْفِرادٌ بِالمَرْمَى!":[89.187,1.624],"تَسْدِيدَةٌ قَوِيَّة...":[90.961,1.279],"فُرْصَةٌ خَطِيرَة!":[92.391,1.18],"!تَصَدٍّ رائِعٌ مِنَ الحارِس!":[93.721,2.361],"!الحارِسُ يَطِيرُ وَيُبْعِدُها!":[96.233,1.786],"حارِسٌ عالَمِيّ!":[98.169,1.783],"إِنْقاذٌ يُساوِي هَدَفاً!":[100.101,1.901],"تَسْدِيدَة...":[102.152,1.107],"مُحاوَلَةٌ عَلَى المَرْمَى...":[103.409,1.653],"!كادَتْ أَنْ تَكُونَ هَدَفاً!":[105.212,2.173],"المُدَرِّبُ لا يُصَدِّق!":[107.535,1.971],"فُرْصَةٌ لا تَتَكَرَّرُ كَثِيراً!":[109.656,2.652],"!القائِم! القائِمُ يَرُدُّ الكُرَة!":[112.458,3.311],"سَنْتِيمِتْراتٌ حَرَمَتْهُ مِنَ الهَدَف!":[115.919,2.593],"مُحاوَلَةٌ قَوِيَّة...":[118.663,1.198],"!الدِّفاعُ يَصُدّ!":[120.01,1.718],"!تَدَخُّلٌ شُجاعٌ مِنَ المُدافِع!":[121.879,2.322],"دِفاعٌ رائِع.":[124.351,1.378],"كُرَةٌ طَوِيلَةٌ خَلْفَ الدِّفاع...":[125.879,1.845],"الرّايَةُ مَرْفُوعَة. تَسَلُّل.":[127.874,2.499],"لا! تَسَلُّل.":[130.523,2.106],"تَقَدَّمَ بِخُطْوَةٍ قَبْلَ التَّمْرِير.":[132.779,2.682],"رُكْنِيَّة.":[135.611,0.729],"العَرْضِيَّةُ تَرْتَفِع...":[136.49,1.28],"!رَأْسِيَّة! فَوْقَ العارِضَةِ بِقَلِيل!":[137.92,2.743],"!رَأْسِيَّةٌ قَرِيبَةٌ جِدّاً!":[140.813,1.525],"كادَتِ الرُّكْنِيَّةُ أَنْ تُثْمِر.":[142.488,1.817],"الحارِسُ يُمْسِكُ الكُرَةَ بِثَبات.":[144.455,1.983],"زالَ الخَطَر.":[146.588,1.106],"تَدَخُّلٌ مُتَأَخِّر!":[147.843,1.418],"تَدَخُّلٌ قَوِيّ!":[149.411,1.43],"بِطاقَةٌ صَفْراء.":[150.991,1.171],"الحَكَمُ يُشْهِرُ البِطاقَةَ الصَّفْراء.":[152.311,2.205],"عَلَيْهِ الحَذَرُ مِنَ الآن.":[154.667,1.828],"تَدَخُّلٌ عَنِيفٌ مِنَ الخَلْف!":[156.645,1.773],"تَدَخُّلٌ خَطِير!":[158.568,1.483],"!بِطاقَةٌ حَمْراء! طَرْد!":[160.201,3.05],"!الحَكَمُ يَطْرُدُهُ مُباشَرَة!":[163.401,2.096],"فَرِيقُهُ يُكْمِلُ بِعَشَرَةِ لاعِبِين!":[165.646,1.687],"خُرُوجٌ حَزِينٌ إِلَى غُرْفَةِ المَلابِس.":[167.483,2.638],"تَدَخُّلٌ مُتَأَخِّرٌ آخَر...":[170.271,1.761],"!الإِنْذارُ الثّانِي! طَرْد!":[172.182,2.584],"لا يَلُومُ إِلّا نَفْسَه.":[174.916,2.313],"تَبْدِيل.":[177.379,0.991],"تَغْيِيرٌ فِي صُفُوفِ الفَرِيق.":[178.52,1.215],"دِماءٌ جَدِيدَة.":[179.885,1.821],"لاعِبٌ عَلَى الأَرْض.":[181.857,1.664],"إِصابَة... والجِهازُ الطِّبِّيُّ يَدْخُل.":[183.67,2.756],"نَتَمَنَّى أَلّا تَكُونَ خَطِيرَة.":[186.577,1.786],"المُدَرِّبُ يُعْطِي تَعْلِيماتٍ جَدِيدَة.":[188.513,2.284],"تَغْيِيرٌ تَكْتِيكِيٌّ مِنَ الدَّكَّة.":[190.946,2.116],"لِنَرَ إِنْ كانَ سَيُغَيِّرُ شَيْئاً.":[193.213,1.448],"اِنْطَلَقَتِ المُباراة!":[194.811,1.812],"!نِهايَةُ الشَّوْطِ الأَوَّل.":[196.773,1.643],"!صافِرَةُ النِّهايَة!":[198.566,1.581],"!إِلَى الوَقْتِ الإِضافِيّ!":[200.297,1.988],"!إِلَى رَكَلاتِ التَّرْجِيح!":[202.435,1.693],"وَقْتٌ بَدَلٌ ضائِع.":[204.278,1.501],"!رَكَلاتُ التَّرْجِيح... أَعْصابٌ مِنْ حَدِيد.":[205.928,2.871],"هَجْمَةٌ مُنَظَّمَة.":[208.95,1.322],"ضَغْطٌ مُتَواصِل.":[210.421,1.135],"مُحاوَلَةٌ لِبِناءِ الهَجْمَة.":[211.706,1.444]}