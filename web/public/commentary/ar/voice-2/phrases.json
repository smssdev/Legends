{"هَجْمَةٌ خَطِيرَة...":[0.0,1.569],"اِنْطِلاقَةٌ سَرِيعَةٌ نَحْوَ المَرْمَى...":[1.719,1.846],"الكُرَةُ تَقْتَرِبُ مِنْ مَنْطِقَةِ الجَزَاء...":[3.715,2.737],"!جُووول! هَدَفٌ رائِع!":[6.602,1.846],"!هَدَف! الكُرَةُ فِي الشِّبَاك!":[8.598,2.559],"!يا سَلام! هَدَفٌ خُرافِيّ!":[11.307,2.539],"المُدَرَّجاتُ تَشْتَعِلُ فَرَحاً!":[13.996,2.109],"أَيُّ هَدَفٍ هٰذا!":[16.255,1.41],"هَدَفٌ يَسْتَحِقُّ التَّصْفِيق!":[17.815,1.583],"عَرْضِيَّةٌ داخِلَ المَنْطِقَة...":[19.548,2.156],"الكُرَةُ تَرْتَفِعُ داخِلَ الصُّنْدُوق...":[21.854,2.583],"!هَدَف! رَأْسِيَّةٌ قَوِيَّةٌ فِي الشِّبَاك!":[24.587,2.846],"!هَدَفٌ بِرَأْسِيَّةٍ رائِعَة!":[27.583,2.369],"لا أَحَدَ يُوقِفُهُ فِي الهَواء!":[30.102,2.29],"اِرْتِقاءٌ رائِع!":[32.542,1.389],"ضَرْبَةٌ حُرَّةٌ عَلَى حُدُودِ المَنْطِقَة.":[34.08,2.136],"الحائِطُ يَتَشَكَّل... والجَمِيعُ يَنْتَظِر.":[36.366,3.304],"!فَوْقَ الحائِطِ وَفِي الزّاوِيَة! هَدَفٌ مُذْهِل!":[39.821,3.894],"!هَدَفٌ مِنْ ضَرْبَةٍ حُرَّة! لَوْحَةٌ فَنِّيَّة!":[43.865,3.239],"الحارِسُ لَمْ يَتَحَرَّك!":[47.254,2.003],"تَسْدِيدَةٌ لا تُصَدّ!":[49.407,1.682],"!فَوْقَ الحائِط... والحارِسُ يَطِيرُ وَيُبْعِدُها!":[51.239,3.651],"!تَصَدٍّ رائِعٌ لِلضَّرْبَةِ الحُرَّة!":[55.04,1.972],"كادَتْ أَنْ تَكُونَ هَدَفاً!":[57.162,1.713],"قَرِيبَةٌ جِدّاً!":[59.026,1.201],"!فَوْقَ العارِضَة!":[60.376,1.348],"!بِجانِبِ القائِم!":[61.874,1.355],"فُرْصَةٌ ضائِعَة.":[63.379,1.076],"رَكْلَةُ جَزاء! الحَكَمُ يُشِيرُ إِلَى النُّقْطَة!":[64.605,3.067],"المَلْعَبُ يَحْبِسُ أَنْفاسَه...":[67.822,2.385],"!هَدَف! الحارِسُ فِي جِهَة، والكُرَةُ فِي جِهَة!":[70.357,3.849],"!هَدَف! تَسْدِيدَةٌ واثِقَة!":[74.356,1.962],"أَعْصابٌ مِنْ حَدِيد!":[76.467,1.265],"!تَصَدَّى! الحارِسُ يَقْرَؤُها!":[77.882,2.388],"!يا لَلرَّوْعَة! الحارِسُ يَصُدُّ رَكْلَةَ الجَزاء!":[80.421,3.463],"لَحْظَةٌ كَبِيرَةٌ فِي المُباراة!":[84.034,1.933],"اِنْفِرادٌ بِالمَرْمَى!":[86.117,1.644],"تَسْدِيدَةٌ قَوِيَّة...":[87.911,1.324],"فُرْصَةٌ خَطِيرَة!":[89.385,1.448],"!تَصَدٍّ رائِعٌ مِنَ الحارِس!":[90.983,2.004],"!الحارِسُ يَطِيرُ وَيُبْعِدُها!":[93.137,2.235],"حارِسٌ عالَمِيّ!":[95.522,1.482],"إِنْقاذٌ يُساوِي هَدَفاً!":[97.154,1.498],"تَسْدِيدَة...":[98.802,0.87],"مُحاوَلَةٌ عَلَى المَرْمَى...":[99.822,1.43],"!كادَتْ أَنْ تَكُونَ هَدَفاً!":[101.401,1.577],"المُدَرِّبُ لا يُصَدِّق!":[103.128,1.733],"فُرْصَةٌ لا تَتَكَرَّرُ كَثِيراً!":[105.011,2.182],"!القائِم! القائِمُ يَرُدُّ الكُرَة!":[107.343,3.376],"سَنْتِيمِتْراتٌ حَرَمَتْهُ مِنَ الهَدَف!":[110.868,2.483],"مُحاوَلَةٌ قَوِيَّة...":[113.501,1.458],"!الدِّفاعُ يَصُدّ!":[115.109,1.431],"!تَدَخُّلٌ شُجاعٌ مِنَ المُدافِع!":[116.691,1.951],"دِفاعٌ رائِع.":[118.791,1.499],"كُرَةٌ طَوِيلَةٌ خَلْفَ الدِّفاع...":[120.44,2.432],"الرّايَةُ مَرْفُوعَة. تَسَلُّل.":[123.022,2.975],"لا! تَسَلُّل.":[126.147,2.048],"تَقَدَّمَ بِخُطْوَةٍ قَبْلَ التَّمْرِير.":[128.345,2.581],"رُكْنِيَّة.":[131.076,0.831],"العَرْضِيَّةُ تَرْتَفِع...":[132.057,1.734],"!رَأْسِيَّة! فَوْقَ العارِضَةِ بِقَلِيل!":[133.94,2.942],"!رَأْسِيَّةٌ قَرِيبَةٌ جِدّاً!":[137.033,1.72],"كادَتِ الرُّكْنِيَّةُ أَنْ تُثْمِر.":[138.903,2.035],"الحارِسُ يُمْسِكُ الكُرَةَ بِثَبات.":[141.088,2.551],"زالَ الخَطَر.":[143.788,1.442],"تَدَخُّلٌ مُتَأَخِّر!":[145.38,1.575],"تَدَخُّلٌ قَوِيّ!":[147.106,1.201],"بِطاقَةٌ صَفْراء.":[148.457,1.073],"الحَكَمُ يُشْهِرُ البِطاقَةَ الصَّفْراء.":[149.68,2.387],"عَلَيْهِ الحَذَرُ مِنَ الآن.":[152.216,2.036],"تَدَخُّلٌ عَنِيفٌ مِنَ الخَلْف!":[154.403,1.545],"تَدَخُّلٌ خَطِير!":[156.097,1.229],"!بِطاقَةٌ حَمْراء! طَرْد!":[157.477,1.85],"!الحَكَمُ يَطْرُدُهُ مُباشَرَة!":[159.476,1.746],"فَرِيقُهُ يُكْمِلُ بِعَشَرَةِ لاعِبِين!":[161.372,2.085],"خُرُوجٌ حَزِينٌ إِلَى غُرْفَةِ المَلابِس.":[163.607,2.39],"تَدَخُّلٌ مُتَأَخِّرٌ آخَر...":[166.147,1.804],"!الإِنْذارُ الثّانِي! طَرْد!":[168.101,2.033],"لا يَلُومُ إِلّا نَفْسَه.":[170.284,1.706],"تَبْدِيل.":[172.14,0.931],"تَغْيِيرٌ فِي صُفُوفِ الفَرِيق.":[173.221,1.438],"دِماءٌ جَدِيدَة.":[174.81,1.751],"لاعِبٌ عَلَى الأَرْض.":[176.711,1.562],"إِصابَة... والجِهازُ الطِّبِّيُّ يَدْخُل.":[178.423,2.97],"نَتَمَنَّى أَلّا تَكُونَ خَطِيرَة.":[181.543,2.078],"المُدَرِّبُ يُعْطِي تَعْلِيماتٍ جَدِيدَة.":[183.771,2.356],"تَغْيِيرٌ تَكْتِيكِيٌّ مِنَ الدَّكَّة.":[186.277,2.319],"لِنَرَ إِنْ كانَ سَيُغَيِّرُ شَيْئاً.":[188.746,2.396],"اِنْطَلَقَتِ المُباراة!":[191.292,1.389],"!نِهايَةُ الشَّوْطِ الأَوَّل.":[192.831,1.92],"!صافِرَةُ النِّهايَة!":[194.9,1.549],"!إِلَى الوَقْتِ الإِضافِيّ!":[196.599,1.604],"!إِلَى رَكَلاتِ التَّرْجِيح!":[198.353,1.618],"وَقْتٌ بَدَلٌ ضائِع.":[200.121,1.304],"!رَكَلاتُ التَّرْجِيح... أَعْصابٌ مِنْ حَدِيد.":[201.575,2.986],"هَجْمَةٌ مُنَظَّمَة.":[204.711,1.365],"ضَغْطٌ مُتَواصِل.":[206.225,1.32],"مُحاوَلَةٌ لِبِناءِ الهَجْمَة.":[207.695,1.51]}