{"أَعْصابٌ مِنْ حَدِيد!":[0.0,1.673],"أَيُّ هَدَفٍ هٰذا!":[1.823,1.421],"إِصابَة... والجِهازُ الطِّبِّيُّ يَدْخُل.":[3.394,2.912],"!إِلَى الوَقْتِ الإِضافِيّ!":[6.456,1.685],"!إِلَى رَكَلاتِ التَّرْجِيح!":[8.291,1.717],"إِنْقاذٌ يُساوِي هَدَفاً!":[10.158,2.04],"!الإِنْذارُ الثّانِي! طَرْد!":[12.348,1.834],"الحائِطُ يَتَشَكَّل... والجَمِيعُ يَنْتَظِر.":[14.333,3.35],"الحارِسُ لَمْ يَتَحَرَّك!":[17.832,1.794],"!الحارِسُ يَطِيرُ وَيُبْعِدُها!":[19.776,2.155],"الحارِسُ يُمْسِكُ الكُرَةَ بِثَبات.":[22.081,2.767],"!الحَكَمُ يَطْرُدُهُ مُباشَرَة!":[24.998,2.19],"الحَكَمُ يُشْهِرُ البِطاقَةَ الصَّفْراء.":[27.338,3.129],"!الدِّفاعُ يَصُدّ!":[30.617,1.302],"الرّايَةُ مَرْفُوعَة. تَسَلُّل.":[32.069,2.225],"العَرْضِيَّةُ تَرْتَفِع...":[34.444,1.749],"!القائِم! القائِمُ يَرُدُّ الكُرَة!":[36.344,2.662],"الكُرَةُ تَرْتَفِعُ داخِلَ الصُّنْدُوق...":[39.156,2.873],"الكُرَةُ تَقْتَرِبُ مِنْ مَنْطِقَةِ الجَزَاء...":[42.179,3.26],"المَلْعَبُ يَحْبِسُ أَنْفاسَه...":[45.589,2.259],"المُدَرَّجاتُ تَشْتَعِلُ فَرَحاً!":[47.998,2.495],"المُدَرِّبُ لا يُصَدِّق!":[50.643,2.026],"المُدَرِّبُ يُعْطِي تَعْلِيماتٍ جَدِيدَة.":[52.818,3.402],"اِرْتِقاءٌ رائِع!":[56.371,1.47],"اِنْطَلَقَتِ المُباراة!":[57.99,1.937],"اِنْطِلاقَةٌ سَرِيعَةٌ نَحْوَ المَرْمَى...":[60.078,3.045],"اِنْفِرادٌ بِالمَرْمَى!":[63.272,1.598],"!بِجانِبِ القائِم!":[65.02,1.322],"!بِطاقَةٌ حَمْراء! طَرْد!":[66.492,1.871],"بِطاقَةٌ صَفْراء.":[68.514,1.582],"تَبْدِيل.":[70.246,0.446],"تَدَخُّلٌ خَطِير!":[70.842,1.424],"!تَدَخُّلٌ شُجاعٌ مِنَ المُدافِع!":[72.416,2.365],"تَدَخُّلٌ عَنِيفٌ مِنَ الخَلْف!":[74.93,2.39],"تَدَخُّلٌ قَوِيّ!":[77.47,1.437],"تَدَخُّلٌ مُتَأَخِّر!":[79.057,1.711],"تَدَخُّلٌ مُتَأَخِّرٌ آخَر...":[80.919,2.234],"تَسْدِيدَة...":[83.303,0.815],"تَسْدِيدَةٌ قَوِيَّة...":[84.268,1.765],"تَسْدِيدَةٌ لا تُصَدّ!":[86.184,1.891],"!تَصَدٍّ رائِعٌ لِلضَّرْبَةِ الحُرَّة!":[88.225,2.524],"!تَصَدٍّ رائِعٌ مِنَ الحارِس!":[90.899,2.062],"!تَصَدَّى! الحارِسُ يَقْرَؤُها!":[93.111,2.282],"تَغْيِيرٌ تَكْتِيكِيٌّ مِنَ الدَّكَّة.":[95.543,2.689],"تَغْيِيرٌ فِي صُفُوفِ الفَرِيق.":[98.382,2.425],"تَقَدَّمَ بِخُطْوَةٍ قَبْلَ التَّمْرِير.":[100.957,2.713],"!جُووول! هَدَفٌ رائِع!":[103.821,1.661],"حارِسٌ عالَمِيّ!":[105.632,1.532],"خُرُوجٌ حَزِينٌ إِلَى غُرْفَةِ المَلابِس.":[107.314,3.271],"دِفاعٌ رائِع.":[110.735,1.193],"دِماءٌ جَدِيدَة.":[112.078,1.559],"!رَأْسِيَّة! فَوْقَ العارِضَةِ بِقَلِيل!":[113.787,2.217],"!رَأْسِيَّةٌ قَرِيبَةٌ جِدّاً!":[116.154,1.995],"!رَكَلاتُ التَّرْجِيح... أَعْصابٌ مِنْ حَدِيد.":[118.299,2.819],"رَكْلَةُ جَزاء! الحَكَمُ يُشِيرُ إِلَى النُّقْطَة!":[121.269,3.658],"رُكْنِيَّة.":[125.076,0.715],"زالَ الخَطَر.":[125.941,1.139],"سَنْتِيمِتْراتٌ حَرَمَتْهُ مِنَ الهَدَف!":[127.231,3.009],"!صافِرَةُ النِّهايَة!":[130.389,1.429],"ضَرْبَةٌ حُرَّةٌ عَلَى حُدُودِ المَنْطِقَة.":[131.969,3.51],"ضَغْطٌ مُتَواصِل.":[135.629,1.479],"عَرْضِيَّةٌ داخِلَ المَنْطِقَة...":[137.258,2.475],"عَلَيْهِ الحَذَرُ مِنَ الآن.":[139.883,2.013],"فَرِيقُهُ يُكْمِلُ بِعَشَرَةِ لاعِبِين!":[142.046,3.056],"!فَوْقَ الحائِط... والحارِسُ يَطِيرُ وَيُبْعِدُها!":[145.252,3.253],"!فَوْقَ الحائِطِ وَفِي الزّاوِيَة! هَدَفٌ مُذْهِل!":[148.655,3.554],"!فَوْقَ العارِضَة!":[152.359,1.222],"فُرْصَةٌ خَطِيرَة!":[153.73,1.642],"فُرْصَةٌ ضائِعَة.":[155.523,1.724],"فُرْصَةٌ لا تَتَكَرَّرُ كَثِيراً!":[157.397,2.583],"قَرِيبَةٌ جِدّاً!":[160.13,1.331],"كادَتِ الرُّكْنِيَّةُ أَنْ تُثْمِر.":[161.611,2.306],"كادَتْ أَنْ تَكُونَ هَدَفاً!":[164.067,1.82],"!كادَتْ أَنْ تَكُونَ هَدَفاً!":[166.037,1.626],"كُرَةٌ طَوِيلَةٌ خَلْفَ الدِّفاع...":[167.814,2.676],"لا أَحَدَ يُوقِفُهُ فِي الهَواء!":[170.64,2.325],"لا يَلُومُ إِلّا نَفْسَه.":[173.114,1.986],"لا! تَسَلُّل.":[175.25,1.182],"لاعِبٌ عَلَى الأَرْض.":[176.581,1.615],"لَحْظَةٌ كَبِيرَةٌ فِي المُباراة!":[178.346,2.743],"لِنَرَ إِنْ كانَ سَيُغَيِّرُ شَيْئاً.":[181.239,2.779],"مُحاوَلَةٌ عَلَى المَرْمَى...":[184.167,1.905],"مُحاوَلَةٌ قَوِيَّة...":[186.222,1.881],"مُحاوَلَةٌ لِبِناءِ الهَجْمَة.":[188.253,2.257],"نَتَمَنَّى أَلّا تَكُونَ خَطِيرَة.":[190.66,2.912],"!نِهايَةُ الشَّوْطِ الأَوَّل.":[193.722,1.784],"هَجْمَةٌ خَطِيرَة...":[195.656,1.584],"هَجْمَةٌ مُنَظَّمَة.":[197.389,1.734],"!هَدَف! الحارِسُ فِي جِهَة، والكُرَةُ فِي جِهَة!":[199.273,3.609],"!هَدَف! الكُرَةُ فِي الشِّبَاك!":[203.032,1.867],"!هَدَف! تَسْدِيدَةٌ واثِقَة!":[205.049,1.911],"!هَدَف! رَأْسِيَّةٌ قَوِيَّةٌ فِي الشِّبَاك!":[207.11,2.884],"!هَدَفٌ بِرَأْسِيَّةٍ رائِعَة!":[210.144,2.17],"!هَدَفٌ مِنْ ضَرْبَةٍ حُرَّة! لَوْحَةٌ فَنِّيَّة!":[212.465,3.635],"هَدَفٌ يَسْتَحِقُّ التَّصْفِيق!":[216.25,2.43],"وَقْتٌ بَدَلٌ ضائِع.":[218.83,1.645],"!يا سَلام! هَدَفٌ خُرافِيّ!":[220.626,2.514],"!يا لَلرَّوْعَة! الحارِسُ يَصُدُّ رَكْلَةَ الجَزاء!":[223.289,3.896]}