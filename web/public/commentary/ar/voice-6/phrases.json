{"هَجْمَةٌ خَطِيرَة...":[0.0,1.9],"اِنْطِلاقَةٌ سَرِيعَةٌ نَحْوَ المَرْمَى...":[2.05,1.778],"الكُرَةُ تَقْتَرِبُ مِنْ مَنْطِقَةِ الجَزَاء...":[3.978,2.826],"!جُووول! هَدَفٌ رائِع!":[6.954,1.454],"!هَدَف! الكُرَةُ فِي الشِّبَاك!":[8.558,3.419],"!يا سَلام! هَدَفٌ خُرافِيّ!":[12.127,3.476],"المُدَرَّجاتُ تَشْتَعِلُ فَرَحاً!":[15.753,2.163],"أَيُّ هَدَفٍ هٰذا!":[18.066,1.677],"هَدَفٌ يَسْتَحِقُّ التَّصْفِيق!":[19.892,1.93],"عَرْضِيَّةٌ داخِلَ المَنْطِقَة...":[21.972,2.512],"الكُرَةُ تَرْتَفِعُ داخِلَ الصُّنْدُوق...":[24.634,2.426],"!هَدَف! رَأْسِيَّةٌ قَوِيَّةٌ فِي الشِّبَاك!":[27.21,4.08],"!هَدَفٌ بِرَأْسِيَّةٍ رائِعَة!":[31.441,2.089],"لا أَحَدَ يُوقِفُهُ فِي الهَواء!":[33.679,2.867],"اِرْتِقاءٌ رائِع!":[36.696,1.859],"ضَرْبَةٌ حُرَّةٌ عَلَى حُدُودِ المَنْطِقَة.":[38.705,2.205],"الحائِطُ يَتَشَكَّل... والجَمِيعُ يَنْتَظِر.":[41.06,3.557],"!فَوْقَ الحائِطِ وَفِي الزّاوِيَة! هَدَفٌ مُذْهِل!":[44.767,3.897],"!هَدَفٌ مِنْ ضَرْبَةٍ حُرَّة! لَوْحَةٌ فَنِّيَّة!":[48.814,3.735],"الحارِسُ لَمْ يَتَحَرَّك!":[52.699,1.979],"تَسْدِيدَةٌ لا تُصَدّ!":[54.828,1.937],"!فَوْقَ الحائِط... والحارِسُ يَطِيرُ وَيُبْعِدُها!":[56.915,4.309],"!تَصَدٍّ رائِعٌ لِلضَّرْبَةِ الحُرَّة!":[61.374,1.79],"كادَتْ أَنْ تَكُونَ هَدَفاً!":[63.314,1.84],"قَرِيبَةٌ جِدّاً!":[65.303,1.272],"!فَوْقَ العارِضَة!":[66.725,1.99],"!بِجانِبِ القائِم!":[68.866,1.639],"فُرْصَةٌ ضائِعَة.":[70.654,1.754],"رَكْلَةُ جَزاء! الحَكَمُ يُشِيرُ إِلَى النُّقْطَة!":[72.558,3.508],"المَلْعَبُ يَحْبِسُ أَنْفاسَه...":[76.216,2.038],"!هَدَف! الحارِسُ فِي جِهَة، والكُرَةُ فِي جِهَة!":[78.405,3.572],"!هَدَف! تَسْدِيدَةٌ واثِقَة!":[82.127,2.957],"أَعْصابٌ مِنْ حَدِيد!":[85.234,2.219],"!تَصَدَّى! الحارِسُ يَقْرَؤُها!":[87.603,2.627],"!يا لَلرَّوْعَة! الحارِسُ يَصُدُّ رَكْلَةَ الجَزاء!":[90.38,4.294],"لَحْظَةٌ كَبِيرَةٌ فِي المُباراة!":[94.824,2.277],"اِنْفِرادٌ بِالمَرْمَى!":[97.251,1.433],"تَسْدِيدَةٌ قَوِيَّة...":[98.834,1.384],"فُرْصَةٌ خَطِيرَة!":[100.368,1.648],"!تَصَدٍّ رائِعٌ مِنَ الحارِس!":[102.166,2.208],"!الحارِسُ يَطِيرُ وَيُبْعِدُها!":[104.524,2.269],"حارِسٌ عالَمِيّ!":[106.943,2.483],"إِنْقاذٌ يُساوِي هَدَفاً!":[109.576,1.938],"تَسْدِيدَة...":[111.664,0.919],"مُحاوَلَةٌ عَلَى المَرْمَى...":[112.734,1.337],"!كادَتْ أَنْ تَكُونَ هَدَفاً!":[114.221,1.985],"المُدَرِّبُ لا يُصَدِّق!":[116.355,1.565],"فُرْصَةٌ لا تَتَكَرَّرُ كَثِيراً!":[118.07,2.397],"!القائِم! القائِمُ يَرُدُّ الكُرَة!":[120.617,4.158],"سَنْتِيمِتْراتٌ حَرَمَتْهُ مِنَ الهَدَف!":[124.925,2.995],"مُحاوَلَةٌ قَوِيَّة...":[128.07,1.789],"!الدِّفاعُ يَصُدّ!":[130.009,2.272],"!تَدَخُّلٌ شُجاعٌ مِنَ المُدافِع!":[132.431,2.203],"دِفاعٌ رائِع.":[134.784,1.52],"كُرَةٌ طَوِيلَةٌ خَلْفَ الدِّفاع...":[136.454,1.938],"الرّايَةُ مَرْفُوعَة. تَسَلُّل.":[138.542,3.28],"لا! تَسَلُّل.":[141.972,2.356],"تَقَدَّمَ بِخُطْوَةٍ قَبْلَ التَّمْرِير.":[144.478,2.386],"رُكْنِيَّة.":[147.014,1.173],"العَرْضِيَّةُ تَرْتَفِع...":[148.337,1.569],"!رَأْسِيَّة! فَوْقَ العارِضَةِ بِقَلِيل!":[150.056,3.426],"!رَأْسِيَّةٌ قَرِيبَةٌ جِدّاً!":[153.632,2.627],"كادَتِ الرُّكْنِيَّةُ أَنْ تُثْمِر.":[156.409,2.718],"الحارِسُ يُمْسِكُ الكُرَةَ بِثَبات.":[159.277,2.814],"زالَ الخَطَر.":[162.241,2.088],"تَدَخُّلٌ مُتَأَخِّر!":[164.479,2.356],"تَدَخُّلٌ قَوِيّ!":[166.985,1.407],"بِطاقَةٌ صَفْراء.":[168.542,1.557],"الحَكَمُ يُشْهِرُ البِطاقَةَ الصَّفْراء.":[170.25,2.729],"عَلَيْهِ الحَذَرُ مِنَ الآن.":[173.128,1.807],"تَدَخُّلٌ عَنِيفٌ مِنَ الخَلْف!":[175.086,1.749],"تَدَخُّلٌ خَطِير!":[176.985,1.619],"!بِطاقَةٌ حَمْراء! طَرْد!":[178.754,2.458],"!الحَكَمُ يَطْرُدُهُ مُباشَرَة!":[181.363,2.539],"فَرِيقُهُ يُكْمِلُ بِعَشَرَةِ لاعِبِين!":[184.052,2.574],"خُرُوجٌ حَزِينٌ إِلَى غُرْفَةِ المَلابِس.":[186.775,2.269],"تَدَخُّلٌ مُتَأَخِّرٌ آخَر...":[189.194,1.669],"!الإِنْذارُ الثّانِي! طَرْد!":[191.013,3.183],"لا يَلُومُ إِلّا نَفْسَه.":[194.346,1.984],"تَبْدِيل.":[196.48,1.497],"تَغْيِيرٌ فِي صُفُوفِ الفَرِيق.":[198.127,1.56],"دِماءٌ جَدِيدَة.":[199.837,1.639],"لاعِبٌ عَلَى الأَرْض.":[201.626,1.798],"إِصابَة... والجِهازُ الطِّبِّيُّ يَدْخُل.":[203.574,2.772],"نَتَمَنَّى أَلّا تَكُونَ خَطِيرَة.":[206.496,2.643],"المُدَرِّبُ يُعْطِي تَعْلِيماتٍ جَدِيدَة.":[209.29,2.173],"تَغْيِيرٌ تَكْتِيكِيٌّ مِنَ الدَّكَّة.":[211.613,2.173],"لِنَرَ إِنْ كانَ سَيُغَيِّرُ شَيْئاً.":[213.936,2.219],"اِنْطَلَقَتِ المُباراة!":[216.305,2.114],"!نِهايَةُ الشَّوْطِ الأَوَّل.":[218.569,2.319],"!صافِرَةُ النِّهايَة!":[221.038,1.619],"!إِلَى الوَقْتِ الإِضافِيّ!":[222.807,2.207],"!إِلَى رَكَلاتِ التَّرْجِيح!":[225.164,2.339],"وَقْتٌ بَدَلٌ ضائِع.":[227.654,1.739],"!رَكَلاتُ التَّرْجِيح... أَعْصابٌ مِنْ حَدِيد.":[229.543,3.009],"هَجْمَةٌ مُنَظَّمَة.":[232.702,1.749],"ضَغْطٌ مُتَواصِل.":[234.6,1.571],"مُحاوَلَةٌ لِبِناءِ الهَجْمَة.":[236.322,1.745]}