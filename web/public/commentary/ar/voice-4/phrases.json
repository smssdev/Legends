{"هَجْمَةٌ خَطِيرَة...":[0.0,1.571],"اِنْطِلاقَةٌ سَرِيعَةٌ نَحْوَ المَرْمَى...":[1.722,2.327],"الكُرَةُ تَقْتَرِبُ مِنْ مَنْطِقَةِ الجَزَاء...":[4.198,3.027],"!جُووول! هَدَفٌ رائِع!":[7.375,2.717],"!هَدَف! الكُرَةُ فِي الشِّبَاك!":[10.242,2.946],"!يا سَلام! هَدَفٌ خُرافِيّ!":[13.339,3.356],"المُدَرَّجاتُ تَشْتَعِلُ فَرَحاً!":[16.845,2.825],"أَيُّ هَدَفٍ هٰذا!":[19.82,1.988],"هَدَفٌ يَسْتَحِقُّ التَّصْفِيق!":[21.958,2.2],"عَرْضِيَّةٌ داخِلَ المَنْطِقَة...":[24.308,2.169],"الكُرَةُ تَرْتَفِعُ داخِلَ الصُّنْدُوق...":[26.628,2.226],"!هَدَف! رَأْسِيَّةٌ قَوِيَّةٌ فِي الشِّبَاك!":[29.004,3.425],"!هَدَفٌ بِرَأْسِيَّةٍ رائِعَة!":[32.579,2.354],"لا أَحَدَ يُوقِفُهُ فِي الهَواء!":[35.083,2.628],"اِرْتِقاءٌ رائِع!":[37.862,1.798],"ضَرْبَةٌ حُرَّةٌ عَلَى حُدُودِ المَنْطِقَة.":[39.81,2.345],"الحائِطُ يَتَشَكَّل... والجَمِيعُ يَنْتَظِر.":[42.305,4.358],"!فَوْقَ الحائِطِ وَفِي الزّاوِيَة! هَدَفٌ مُذْهِل!":[46.813,4.061],"!هَدَفٌ مِنْ ضَرْبَةٍ حُرَّة! لَوْحَةٌ فَنِّيَّة!":[51.024,3.471],"الحارِسُ لَمْ يَتَحَرَّك!":[54.645,2.502],"تَسْدِيدَةٌ لا تُصَدّ!":[57.296,1.794],"!فَوْقَ الحائِط... والحارِسُ يَطِيرُ وَيُبْعِدُها!":[59.24,4.127],"!تَصَدٍّ رائِعٌ لِلضَّرْبَةِ الحُرَّة!":[63.517,2.207],"كادَتْ أَنْ تَكُونَ هَدَفاً!":[65.874,1.935],"قَرِيبَةٌ جِدّاً!":[67.959,1.843],"!فَوْقَ العارِضَة!":[69.952,1.66],"!بِجانِبِ القائِم!":[71.762,1.784],"فُرْصَةٌ ضائِعَة.":[73.696,1.517],"رَكْلَةُ جَزاء! الحَكَمُ يُشِيرُ إِلَى النُّقْطَة!":[75.363,4.175],"المَلْعَبُ يَحْبِسُ أَنْفاسَه...":[79.688,2.277],"!هَدَف! الحارِسُ فِي جِهَة، والكُرَةُ فِي جِهَة!":[82.114,3.802],"!هَدَف! تَسْدِيدَةٌ واثِقَة!":[86.066,2.592],"أَعْصابٌ مِنْ حَدِيد!":[88.808,1.935],"!تَصَدَّى! الحارِسُ يَقْرَؤُها!":[90.892,2.876],"!يا لَلرَّوْعَة! الحارِسُ يَصُدُّ رَكْلَةَ الجَزاء!":[93.919,3.845],"لَحْظَةٌ كَبِيرَةٌ فِي المُباراة!":[97.913,2.064],"اِنْفِرادٌ بِالمَرْمَى!":[100.128,1.989],"تَسْدِيدَةٌ قَوِيَّة...":[102.266,1.624],"فُرْصَةٌ خَطِيرَة!":[104.041,1.702],"!تَصَدٍّ رائِعٌ مِنَ الحارِس!":[105.892,2.489],"!الحارِسُ يَطِيرُ وَيُبْعِدُها!":[108.531,2.241],"حارِسٌ عالَمِيّ!":[110.922,1.848],"إِنْقاذٌ يُساوِي هَدَفاً!":[112.92,1.779],"تَسْدِيدَة...":[114.849,1.203],"مُحاوَلَةٌ عَلَى المَرْمَى...":[116.202,1.913],"!كادَتْ أَنْ تَكُونَ هَدَفاً!":[118.265,2.172],"المُدَرِّبُ لا يُصَدِّق!":[120.587,2.121],"فُرْصَةٌ لا تَتَكَرَّرُ كَثِيراً!":[122.857,2.578],"!القائِم! القائِمُ يَرُدُّ الكُرَة!":[125.585,3.567],"سَنْتِيمِتْراتٌ حَرَمَتْهُ مِنَ الهَدَف!":[129.302,2.64],"مُحاوَلَةٌ قَوِيَّة...":[132.092,1.748],"!الدِّفاعُ يَصُدّ!":[133.99,1.79],"!تَدَخُّلٌ شُجاعٌ مِنَ المُدافِع!":[135.93,2.412],"دِفاعٌ رائِع.":[138.492,1.746],"كُرَةٌ طَوِيلَةٌ خَلْفَ الدِّفاع...":[140.389,1.99],"الرّايَةُ مَرْفُوعَة. تَسَلُّل.":[142.529,2.771],"لا! تَسَلُّل.":[145.449,2.372],"تَقَدَّمَ بِخُطْوَةٍ قَبْلَ التَّمْرِير.":[147.971,2.853],"رُكْنِيَّة.":[150.975,1.139],"العَرْضِيَّةُ تَرْتَفِع...":[152.264,1.937],"!رَأْسِيَّة! فَوْقَ العارِضَةِ بِقَلِيل!":[154.351,3.558],"!رَأْسِيَّةٌ قَرِيبَةٌ جِدّاً!":[158.059,2.314],"كادَتِ الرُّكْنِيَّةُ أَنْ تُثْمِر.":[160.523,2.456],"الحارِسُ يُمْسِكُ الكُرَةَ بِثَبات.":[163.128,2.316],"زالَ الخَطَر.":[165.594,1.337],"تَدَخُّلٌ مُتَأَخِّر!":[167.081,1.873],"تَدَخُّلٌ قَوِيّ!":[169.104,1.517],"بِطاقَةٌ صَفْراء.":[170.771,1.408],"الحَكَمُ يُشْهِرُ البِطاقَةَ الصَّفْراء.":[172.329,2.623],"عَلَيْهِ الحَذَرُ مِنَ الآن.":[175.102,2.112],"تَدَخُّلٌ عَنِيفٌ مِنَ الخَلْف!":[177.364,2.262],"تَدَخُّلٌ خَطِير!":[179.776,1.594],"!بِطاقَةٌ حَمْراء! طَرْد!":[181.52,2.508],"!الحَكَمُ يَطْرُدُهُ مُباشَرَة!":[184.178,2.298],"فَرِيقُهُ يُكْمِلُ بِعَشَرَةِ لاعِبِين!":[186.626,2.73],"خُرُوجٌ حَزِينٌ إِلَى غُرْفَةِ المَلابِس.":[189.507,2.624],"تَدَخُّلٌ مُتَأَخِّرٌ آخَر...":[192.281,2.738],"!الإِنْذارُ الثّانِي! طَرْد!":[195.169,2.908],"لا يَلُومُ إِلّا نَفْسَه.":[198.227,1.888],"تَبْدِيل.":[200.265,1.137],"تَغْيِيرٌ فِي صُفُوفِ الفَرِيق.":[201.552,1.748],"دِماءٌ جَدِيدَة.":[203.45,2.059],"لاعِبٌ عَلَى الأَرْض.":[205.659,2.225],"إِصابَة... والجِهازُ الطِّبِّيُّ يَدْخُل.":[208.034,3.526],"نَتَمَنَّى أَلّا تَكُونَ خَطِيرَة.":[211.71,2.294],"المُدَرِّبُ يُعْطِي تَعْلِيماتٍ جَدِيدَة.":[214.155,2.383],"تَغْيِيرٌ تَكْتِيكِيٌّ مِنَ الدَّكَّة.":[216.688,2.642],"لِنَرَ إِنْ كانَ سَيُغَيِّرُ شَيْئاً.":[219.479,2.877],"اِنْطَلَقَتِ المُباراة!":[222.506,1.806],"!نِهايَةُ الشَّوْطِ الأَوَّل.":[224.463,1.937],"!صافِرَةُ النِّهايَة!":[226.55,1.943],"!إِلَى الوَقْتِ الإِضافِيّ!":[228.643,2.25],"!إِلَى رَكَلاتِ التَّرْجِيح!":[231.043,2.081],"وَقْتٌ بَدَلٌ ضائِع.":[233.274,1.882],"!رَكَلاتُ التَّرْجِيح... أَعْصابٌ مِنْ حَدِيد.":[235.306,3.714],"هَجْمَةٌ مُنَظَّمَة.":[239.17,1.763],"ضَغْطٌ مُتَواصِل.":[241.083,1.567],"مُحاوَلَةٌ لِبِناءِ الهَجْمَة.":[242.8,2.092]}