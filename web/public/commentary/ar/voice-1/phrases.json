{"هَجْمَةٌ خَطِيرَة...":[0.0,1.389],"اِنْطِلاقَةٌ سَرِيعَةٌ نَحْوَ المَرْمَى...":[1.539,2.091],"الكُرَةُ تَقْتَرِبُ مِنْ مَنْطِقَةِ الجَزَاء...":[3.78,3.519],"!جُووول! هَدَفٌ رائِع!":[7.449,2.306],"!هَدَف! الكُرَةُ فِي الشِّبَاك!":[9.905,2.992],"!يا سَلام! هَدَفٌ خُرافِيّ!":[13.047,2.458],"المُدَرَّجاتُ تَشْتَعِلُ فَرَحاً!":[15.655,2.544],"أَيُّ هَدَفٍ هٰذا!":[18.349,1.223],"هَدَفٌ يَسْتَحِقُّ التَّصْفِيق!":[19.722,1.893],"عَرْضِيَّةٌ داخِلَ المَنْطِقَة...":[21.765,1.909],"الكُرَةُ تَرْتَفِعُ داخِلَ الصُّنْدُوق...":[23.824,3.044],"!هَدَف! رَأْسِيَّةٌ قَوِيَّةٌ فِي الشِّبَاك!":[27.018,3.482],"!هَدَفٌ بِرَأْسِيَّةٍ رائِعَة!":[30.65,2.837],"لا أَحَدَ يُوقِفُهُ فِي الهَواء!":[33.637,2.941],"اِرْتِقاءٌ رائِع!":[36.728,1.654],"ضَرْبَةٌ حُرَّةٌ عَلَى حُدُودِ المَنْطِقَة.":[38.532,2.177],"الحائِطُ يَتَشَكَّل... والجَمِيعُ يَنْتَظِر.":[40.859,3.373],"!فَوْقَ الحائِطِ وَفِي الزّاوِيَة! هَدَفٌ مُذْهِل!":[44.381,3.935],"!هَدَفٌ مِنْ ضَرْبَةٍ حُرَّة! لَوْحَةٌ فَنِّيَّة!":[48.466,3.153],"الحارِسُ لَمْ يَتَحَرَّك!":[51.769,1.991],"تَسْدِيدَةٌ لا تُصَدّ!":[53.91,2.093],"!فَوْقَ الحائِط... والحارِسُ يَطِيرُ وَيُبْعِدُها!":[56.152,4.064],"!تَصَدٍّ رائِعٌ لِلضَّرْبَةِ الحُرَّة!":[60.366,2.311],"كادَتْ أَنْ تَكُونَ هَدَفاً!":[62.827,1.686],"قَرِيبَةٌ جِدّاً!":[64.663,1.209],"!فَوْقَ العارِضَة!":[66.022,1.262],"!بِجانِبِ القائِم!":[67.434,1.593],"فُرْصَةٌ ضائِعَة.":[69.178,1.935],"رَكْلَةُ جَزاء! الحَكَمُ يُشِيرُ إِلَى النُّقْطَة!":[71.263,4.043],"المَلْعَبُ يَحْبِسُ أَنْفاسَه...":[75.456,2.891],"!هَدَف! الحارِسُ فِي جِهَة، والكُرَةُ فِي جِهَة!":[78.497,5.073],"!هَدَف! تَسْدِيدَةٌ واثِقَة!":[83.72,2.634],"أَعْصابٌ مِنْ حَدِيد!":[86.504,1.416],"!تَصَدَّى! الحارِسُ يَقْرَؤُها!":[88.071,2.937],"!يا لَلرَّوْعَة! الحارِسُ يَصُدُّ رَكْلَةَ الجَزاء!":[91.157,4.204],"لَحْظَةٌ كَبِيرَةٌ فِي المُباراة!":[95.511,2.654],"اِنْفِرادٌ بِالمَرْمَى!":[98.316,1.732],"تَسْدِيدَةٌ قَوِيَّة...":[100.198,1.514],"فُرْصَةٌ خَطِيرَة!":[101.862,1.793],"!تَصَدٍّ رائِعٌ مِنَ الحارِس!":[103.805,2.438],"!الحارِسُ يَطِيرُ وَيُبْعِدُها!":[106.393,2.132],"حارِسٌ عالَمِيّ!":[108.675,1.758],"إِنْقاذٌ يُساوِي هَدَفاً!":[110.583,1.543],"تَسْدِيدَة...":[112.276,1.068],"مُحاوَلَةٌ عَلَى المَرْمَى...":[113.494,1.637],"!كادَتْ أَنْ تَكُونَ هَدَفاً!":[115.281,2.018],"المُدَرِّبُ لا يُصَدِّق!":[117.449,2.21],"فُرْصَةٌ لا تَتَكَرَّرُ كَثِيراً!":[119.809,2.977],"!القائِم! القائِمُ يَرُدُّ الكُرَة!":[122.936,3.178],"سَنْتِيمِتْراتٌ حَرَمَتْهُ مِنَ الهَدَف!":[126.264,2.654],"مُحاوَلَةٌ قَوِيَّة...":[129.067,1.604],"!الدِّفاعُ يَصُدّ!":[130.821,1.512],"!تَدَخُّلٌ شُجاعٌ مِنَ المُدافِع!":[132.483,2.265],"دِفاعٌ رائِع.":[134.899,1.523],"كُرَةٌ طَوِيلَةٌ خَلْفَ الدِّفاع...":[136.572,2.523],"الرّايَةُ مَرْفُوعَة. تَسَلُّل.":[139.244,2.576],"لا! تَسَلُّل.":[141.97,1.525],"تَقَدَّمَ بِخُطْوَةٍ قَبْلَ التَّمْرِير.":[143.645,3.738],"رُكْنِيَّة.":[147.533,1.175],"العَرْضِيَّةُ تَرْتَفِع...":[148.858,1.328],"!رَأْسِيَّة! فَوْقَ العارِضَةِ بِقَلِيل!":[150.336,3.121],"!رَأْسِيَّةٌ قَرِيبَةٌ جِدّاً!":[153.607,1.833],"كادَتِ الرُّكْنِيَّةُ أَنْ تُثْمِر.":[155.59,2.603],"الحارِسُ يُمْسِكُ الكُرَةَ بِثَبات.":[158.342,2.798],"زالَ الخَطَر.":[161.29,1.349],"تَدَخُّلٌ مُتَأَخِّر!":[162.789,1.477],"تَدَخُّلٌ قَوِيّ!":[164.416,1.286],"بِطاقَةٌ صَفْراء.":[165.852,1.178],"الحَكَمُ يُشْهِرُ البِطاقَةَ الصَّفْراء.":[167.18,2.351],"عَلَيْهِ الحَذَرُ مِنَ الآن.":[169.682,2.209],"تَدَخُّلٌ عَنِيفٌ مِنَ الخَلْف!":[172.041,1.929],"تَدَخُّلٌ خَطِير!":[174.12,1.562],"!بِطاقَةٌ حَمْراء! طَرْد!":[175.832,2.179],"!الحَكَمُ يَطْرُدُهُ مُباشَرَة!":[178.162,2.707],"فَرِيقُهُ يُكْمِلُ بِعَشَرَةِ لاعِبِين!":[181.019,2.642],"خُرُوجٌ حَزِينٌ إِلَى غُرْفَةِ المَلابِس.":[183.81,2.936],"تَدَخُّلٌ مُتَأَخِّرٌ آخَر...":[186.896,2.095],"!الإِنْذارُ الثّانِي! طَرْد!":[189.141,2.436],"لا يَلُومُ إِلّا نَفْسَه.":[191.728,1.587],"تَبْدِيل.":[193.465,0.935],"تَغْيِيرٌ فِي صُفُوفِ الفَرِيق.":[194.55,1.583],"دِماءٌ جَدِيدَة.":[196.283,1.673],"لاعِبٌ عَلَى الأَرْض.":[198.106,2.395],"إِصابَة... والجِهازُ الطِّبِّيُّ يَدْخُل.":[200.651,3.558],"نَتَمَنَّى أَلّا تَكُونَ خَطِيرَة.":[204.359,2.339],"المُدَرِّبُ يُعْطِي تَعْلِيماتٍ جَدِيدَة.":[206.848,2.806],"تَغْيِيرٌ تَكْتِيكِيٌّ مِنَ الدَّكَّة.":[209.804,1.93],"لِنَرَ إِنْ كانَ سَيُغَيِّرُ شَيْئاً.":[211.884,1.927],"اِنْطَلَقَتِ المُباراة!":[213.961,1.282],"!نِهايَةُ الشَّوْطِ الأَوَّل.":[215.393,1.659],"!صافِرَةُ النِّهايَة!":[217.202,1.734],"!إِلَى الوَقْتِ الإِضافِيّ!":[219.087,1.907],"!إِلَى رَكَلاتِ التَّرْجِيح!":[221.143,2.427],"وَقْتٌ بَدَلٌ ضائِع.":[223.721,1.875],"!رَكَلاتُ التَّرْجِيح... أَعْصابٌ مِنْ حَدِيد.":[225.746,3.588],"هَجْمَةٌ مُنَظَّمَة.":[229.483,1.722],"ضَغْطٌ مُتَواصِل.":[231.355,1.243],"مُحاوَلَةٌ لِبِناءِ الهَجْمَة.":[232.748,1.645]}