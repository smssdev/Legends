{"start": 125.0, "end": 127.83, "text": "وكبين اكتزادين وكراوياً", "lp": -1.08, "rms": 0.075, "peak": 0.257}
{"start": 128.07, "end": 132.15, "text": "ناده بارشانونه وولد عالفوط فمنى ميابد السعب السعيين", "lp": -0.98, "rms": 0.0759, "peak": 0.228}
{"start": 132.3, "end": 133.5, "text": "ليقل لان", "lp": -1.21, "rms": 0.0709, "peak": 0.233}
{"start": 133.61, "end": 138.1, "text": "وليكون شوك في حلق الاد العاصمة والرعال", "lp": -0.5, "rms": 0.0701, "peak": 0.237}
{"start": 138.15, "end": 140.92, "text": "أو شدو في الفتصعم والتنين", "lp": -0.62, "rms": 0.0706, "peak": 0.238}
{"start": 141.03, "end": 142.52, "text": "ليو ذكر الجميع", "lp": -0.49, "rms": 0.0681, "peak": 0.224}
{"start": 142.63, "end": 146.71, "text": "بسباني الوحد المتحدة رمسوها مدريد", "lp": -0.37, "rms": 0.0747, "peak": 0.239}
{"start": 146.76, "end": 152.41, "text": "ولا سوت يعلفوا قصوترية لها! آكذا استقال مشاعدين", "lp": -0.84, "rms": 0.0743, "peak": 0.262}
{"start": 152.81, "end": 154.39, "text": "عبر جزيرة العرب", "lp": -0.32, "rms": 0.0816, "peak": 0.267}
{"start": 154.63, "end": 157.66, "text": "ننطلق من كامبنو بارسلونة", "lp": -0.65, "rms": 0.0781, "peak": 0.268}
{"start": 157.86, "end": 160.63, "text": "في قالك لسيكو لسيكو العالم", "lp": -0.68, "rms": 0.0731, "peak": 0.256}
{"start": 160.78, "end": 162.81, "text": "لقائم تلق في الحضاب", "lp": -0.6, "rms": 0.0765, "peak": 0.268}
{"start": 163.05, "end": 168.98, "text": "لقاء صفحين مرينه وقرد يولى لقال مجرمين مسيوروننده", "lp": -0.61, "rms": 0.0779, "peak": 0.267}
{"start": 168.98, "end": 171.03, "text": "لكامن يملك ثلاث ريات", "lp": -0.78, "rms": 0.0713, "peak": 0.25}
{"start": 171.21, "end": 175.77, "text": "وليس فنة دائن مثل باكي الباشر اخزيره البوسكات", "lp": -0.97, "rms": 0.0798, "peak": 0.295}
{"start": 175.88, "end": 176.76, "text": "بي مبارد", "lp": -1.17, "rms": 0.0796, "peak": 0.244}
{"start": 176.87, "end": 179.96, "text": "يملك فيها عيني زرقال يمامة", "lp": -0.37, "rms": 0.0728, "peak": 0.23}
{"start": 179.98, "end": 185.34, "text": "في دقال التفين في ابن زما", "lp": -1.4, "rms": 0.0757, "peak": 0.254}
{"start": 185.35, "end": 188.15, "text": "لكامن كانوا ل العالم الدور والنالدو", "lp": -0.76, "rms": 0.0823, "peak": 0.282}
{"start": 188.2, "end": 193.24, "text": "واليقايا احضر فيها واللعالم ممامكم ملك الملوكمسي واليقا", "lp": -0.61, "rms": 0.077, "peak": 0.283}
{"start": 193.29, "end": 199.65, "text": "يخضر به الفيود شرن بروان على العالموزين أي موت عن انتظر", "lp": -0.53, "rms": 0.0767, "peak": 0.265}
{"start": 199.65, "end": 203.61, "text": "عني لقاصة وعلك عني لاسميسة حدث", "lp": -0.45, "rms": 0.0788, "peak": 0.281}
{"start": 203.72, "end": 205.11, "text": "سأخم للمان", "lp": -0.83, "rms": 0.0706, "peak": 0.272}
{"start": 205.16, "end": 212.11, "text": "سوى على قليمن سوى نشد من ونوى بمن وأو مجد من من سيعب أرمن", "lp": -0.66, "rms": 0.078, "peak": 0.267}
{"start": 212.11, "end": 216.86, "text": "من سيوبك من من ينتصر في مراجع عروها", "lp": -0.41, "rms": 0.0746, "peak": 0.238}
{"start": 216.86, "end": 222.42, "text": "أنه زيما تعر وانتسار مجديئة كورالدي هذا حكة من المراب", "lp": -0.95, "rms": 0.073, "peak": 0.247}
{"start": 222.5, "end": 226.2, "text": "اتقورالتي جنزاليس اي ريال بلاين كمتريد", "lp": -1.25, "rms": 0.0797, "peak": 0.257}
{"start": 226.34, "end": 232.27, "text": "حرس مرمي كركسيس على من السرج رموز على يسار مرسلو", "lp": -0.67, "rms": 0.0687, "peak": 0.241}
{"start": 232.27, "end": 237.46, "text": "في المحوة الكارض كارواله وطلقة ببه ثوني البيضو", "lp": -0.98, "rms": 0.0792, "peak": 0.261}
{"start": 237.61, "end": 239.79, "text": "قديرا سامير باشرين", "lp": -1.08, "rms": 0.0736, "peak": 0.255}
{"start": 239.79, "end": 246.23, "text": "أربع التشت شرل أنسو عالمين دماريا عالمي صار الدون ورال مواجم", "lp": -0.75, "rms": 0.0752, "peak": 0.255}
{"start": 246.25, "end": 251.78, "text": "يا العبوزيه وراء لاورا دبن زمى ساعة كريم", "lp": -0.59, "rms": 0.0736, "peak": 0.232}
{"start": 251.78, "end": 253.69, "text": "في ليلة الكامпنة", "lp": -0.99, "rms": 0.0637, "peak": 0.215}
{"start": 254.79, "end": 256.6, "text": "أعطباً في تنكت في حد", "lp": -1.84, "rms": 0.0787, "peak": 0.263}
{"start": 257.7, "end": 261.82, "text": "عشق روال السلو من اختيار رو مورينه", "lp": -0.98, "rms": 0.0693, "peak": 0.216}
{"start": 261.96, "end": 265.21, "text": "باب الجواربي ولا وبيني تككيك ولرب عم تادت تادت تادت تادت", "lp": -1.02, "rms": 0.075, "peak": 0.239}
{"start": 265.48, "end": 270.62, "text": "و الديس عالبش عن نمينة بدا العلي الصار بوليون وبكيف اللكس", "lp": -0.91, "rms": 0.0702, "peak": 0.218}
{"start": 270.63, "end": 276.12, "text": "جابي بس كتسين يستى موتورحة رواصد في الدرومسي بيى", "lp": -1.14, "rms": 0.0712, "peak": 0.214}
{"start": 276.17, "end": 281.66, "text": "ارعب مليو لذا انت انت لك المرات على كل السكورة كميحده ستين", "lp": -0.83, "rms": 0.072, "peak": 0.225}
{"start": 281.67, "end": 286.36, "text": "الكلاسيب في القام في الضاشم بطال العالم في الكامبنو", "lp": -0.87, "rms": 0.0717, "peak": 0.225}
{"start": 286.38, "end": 292.15, "text": "لقافي الصحب البلور الدور يخر عمين المرشحيني كرة الدابا دعام", "lp": -0.81, "rms": 0.073, "peak": 0.216}
{"start": 292.65, "end": 294.14, "text": "من بتطعش اللي اعب", "lp": -0.98, "rms": 0.0699, "peak": 0.215}
{"start": 294.38, "end": 296.41, "text": "أصدرني لفلوكام", "lp": -1.23, "rms": 0.0652, "peak": 0.19}
{"start": 296.49, "end": 302.1, "text": "ستعشن بطولة فراسيدة مداربائين من تشن لك بحقكة والكربال", "lp": -0.95, "rms": 0.0696, "peak": 0.213}
{"start": 302.12, "end": 308.82, "text": "وحضو عصين كل عسك وفيرها سيطبو يول على الرقام بتوالى و التواريخ بتوالى", "lp": -0.8, "rms": 0.0699, "peak": 0.206}
{"start": 308.82, "end": 314.14, "text": "وطب تقبير يا مراهنجي وطب تساهير يا بارتلونة", "lp": -0.77, "rms": 0.0711, "peak": 0.22}
{"start": 314.28, "end": 320.18, "text": "ينتنة قليقا ليس لدينا وقت الكلمة على الرقام عن شلب المؤقائيات", "lp": -0.76, "rms": 0.0697, "peak": 0.226}
{"start": 320.3, "end": 324.06, "text": "في حديث الجمهرية في كلام عن السعبية", "lp": -0.33, "rms": 0.0699, "peak": 0.218}
{"start": 324.17, "end": 330.51, "text": "في الفين وسبعة سنفد راس عن مهد لبحث الاجتماعيار والنالدو في مدريد", "lp": -0.59, "rms": 0.0715, "peak": 0.247}
{"start": 330.51, "end": 335.03, "text": "أنوا ريالك برنادي شعبية في اسبانيا في دينو تلسي بلمياء", "lp": -0.8, "rms": 0.0705, "peak": 0.26}
{"start": 335.08, "end": 337.88, "text": "مالبوليكوز بارتيبو في إسبانيا", "lp": -1.37, "rms": 0.0846, "peak": 0.293}
{"start": 337.9, "end": 342.84, "text": "يوشششع البلاكو قدام البرص بخم 25 في المية", "lp": -0.66, "rms": 0.0746, "peak": 0.279}
{"start": 342.98, "end": 349.4, "text": "امهور بيان اشتيت اشتيت اشتيت اميونيو اشتبار ماركة بلالمانية اتبولانو البرسة", "lp": -0.86, "rms": 0.0746, "peak": 0.279}
{"start": 349.45, "end": 351.61, "text": "ربيا محبوب على المدريد", "lp": -0.56, "rms": 0.0723, "peak": 0.272}
{"start": 351.78, "end": 353.85, "text": "ومن يو خمسي مليون مشتشع", "lp": -0.71, "rms": 0.0703, "peak": 0.242}
{"start": 354.02, "end": 355.1, "text": "ميلي بلوقرانة", "lp": -1.42, "rms": 0.0713, "peak": 0.238}
{"start": 355.27, "end": 358.65, "text": "وحده تلاثير مليون في ربها للمدريد", "lp": -0.57, "rms": 0.0712, "peak": 0.249}
{"start": 358.79, "end": 360.15, "text": "لك نستلنا يا ريال", "lp": -0.89, "rms": 0.064, "peak": 0.241}
{"start": 360.3, "end": 362.1, "text": "البرسة عن طوروبة", "lp": -0.74, "rms": 0.0857, "peak": 0.319}
{"start": 362.1, "end": 367.93, "text": "ونت عندك الدنيا على المستوى العالمي جميع تهارفر دلمايكي السيرى", "lp": -0.46, "rms": 0.0788, "peak": 0.283}
{"start": 368.17, "end": 370.17, "text": "أنت but that fear is the name", "lp": -1.37, "rms": 0.0843, "peak": 0.326}
{"start": 370.34, "end": 373.43, "text": "وفستبياً لنا رأة الفلوطمانيا", "lp": -0.94, "rms": 0.0727, "peak": 0.232}
{"start": 373.93, "end": 376.6, "text": "في العالم مي دين وثماني عشي مليون", "lp": -0.66, "rms": 0.0706, "peak": 0.227}
{"start": 376.65, "end": 383.18, "text": "اللي لا تلبهم يخفق اليوم خيفين اليوم متيقنين أو متمانين", "lp": -0.71, "rms": 0.0727, "peak": 0.243}
{"start": 383.18, "end": 386.07, "text": "سنار وعودة البيعنك في نوكام", "lp": -0.87, "rms": 0.0663, "peak": 0.196}
{"start": 386.18, "end": 392.25, "text": "ينطلق لوجوم لها تختيين شاوطوه للبارسة قرختي را تبارسة من ببقي", "lp": -1.21, "rms": 0.0771, "peak": 0.265}
{"start": 392.36, "end": 395.13, "text": "ما فيس مقادمات بيحكى بادي", "lp": -1.0, "rms": 0.0695, "peak": 0.234}
{"start": 395.82, "end": 397.66, "text": "بيثار عمي نجادي باين", "lp": -0.97, "rms": 0.0725, "peak": 0.229}
{"start": 397.93, "end": 401.05, "text": "مبارت افتروا تنقطع المطلب من تسابد ريال", "lp": -1.33, "rms": 0.0696, "peak": 0.223}
{"start": 401.22, "end": 404.66, "text": "على بؤدي نقطة الفريق لبلغ وقلنا برثلونة", "lp": -0.78, "rms": 0.0694, "peak": 0.241}
{"start": 407.66, "end": 413.72, "text": "أنه هاد المرصب عبتاءس في تريحي الكلاسكو الذي البرسة يلعب في نوك كام في يستودي في الريال", "lp": -0.87, "rms": 0.0674, "peak": 0.215}
{"start": 414.02, "end": 415.9, "text": "واريال اول الترقيم", "lp": -0.64, "rms": 0.0686, "peak": 0.231}
{"start": 416.07, "end": 417.46, "text": "مرسباتا", "lp": -0.92, "rms": 0.0647, "peak": 0.225}
{"start": 417.61, "end": 419.1, "text": "ترسى الكورة من قدر", "lp": -0.9, "rms": 0.0795, "peak": 0.313}
{"start": 419.27, "end": 421.21, "text": "الكورة فيناس البوسكتز", "lp": -0.82, "rms": 0.0731, "peak": 0.273}
{"start": 421.38, "end": 422.62, "text": "احد عمي", "lp": -0.51, "rms": 0.0623, "peak": 0.233}
{"start": 423.02, "end": 430.01, "text": "الآن المدريد المدريد المدريد", "lp": -1.58, "rms": 0.0759, "peak": 0.26}
{"start": 430.02, "end": 434.36, "text": "لكني توردكم سرس حتى يتوردت خلف العب", "lp": -0.54, "rms": 0.0665, "peak": 0.211}
{"start": 434.5, "end": 437.72, "text": "لانه اتساء ملما تريد من هذا الرسول", "lp": -0.84, "rms": 0.0754, "peak": 0.241}
{"start": 437.96, "end": 440.98, "text": "تشعر من سافره جنزلز", "lp": -0.97, "rms": 0.0749, "peak": 0.276}
{"start": 441.19, "end": 446.1, "text": "السفر الكلاسك مارتين الدوز عادوا الفريك البارثلونة", "lp": -0.74, "rms": 0.0723, "peak": 0.25}
{"start": 446.28, "end": 447.1, "text": "الهومة", "lp": -1.32, "rms": 0.077, "peak": 0.237}
{"start": 447.27, "end": 448.18, "text": "مرحبا", "lp": -1.22, "rms": 0.0737, "peak": 0.228}
{"start": 448.49, "end": 451.35, "text": "بعشر مترد مدريد في عشر الصديد", "lp": -0.64, "rms": 0.0655, "peak": 0.205}
{"start": 452.01, "end": 453.46, "text": "تقعه تُنِ لَمْطَر", "lp": -1.22, "rms": 0.0682, "peak": 0.219}
{"start": 453.61, "end": 455.7, "text": "وصدتها تنى الأمطار", "lp": -0.74, "rms": 0.0727, "peak": 0.243}
{"start": 455.82, "end": 460.63, "text": "في مطابع من كل الأمصار والاقتر يريدون المكسب", "lp": -0.4, "rms": 0.0772, "peak": 0.268}
{"start": 460.68, "end": 465.21, "text": "الذي تنتظره مدريد من قلس عوام في نيوكام", "lp": -0.71, "rms": 0.0737, "peak": 0.254}
{"start": 465.32, "end": 471.32, "text": "ثم شكور عن طريق رونالده رونالده واسخطيرة يخرج فيكتر فلتس", "lp": -0.57, "rms": 0.0761, "peak": 0.252}
{"start": 471.85, "end": 473.08, "text": "هولا أولا من المدريد", "lp": -0.95, "rms": 0.0778, "peak": 0.263}
{"start": 473.45, "end": 474.33, "text": "أسرع", "lp": -0.79, "rms": 0.0757, "peak": 0.279}
{"start": 474.7, "end": 476.95, "text": "قال عنه كرنطو", "lp": -0.74, "rms": 0.0826, "peak": 0.288}
{"start": 478.41, "end": 479.29, "text": "ليس", "lp": -0.59, "rms": 0.0499, "peak": 0.194}
{"start": 479.94, "end": 482.14, "text": "من الذكة تلمين الحماته", "lp": -0.73, "rms": 0.0729, "peak": 0.27}
{"start": 482.6, "end": 486.17, "text": "أنوا عنونا لكلاسك والنه بيني وبينماسي", "lp": -0.64, "rms": 0.0698, "peak": 0.25}
{"start": 486.79, "end": 488.57, "text": "ممقا نوع عوروب من الراسط", "lp": -0.91, "rms": 0.0762, "peak": 0.269}
{"start": 489.1, "end": 491.86, "text": "سبع السفر لله على كريس تانه", "lp": -0.63, "rms": 0.0698, "peak": 0.25}
{"start": 492.23, "end": 493.4, "text": "سبب I did", "lp": -1.11, "rms": 0.0807, "peak": 0.304}
{"start": 493.8, "end": 495.7, "text": "دوانه على رجن تيني", "lp": -0.96, "rms": 0.0733, "peak": 0.244}
{"start": 495.91, "end": 499.1, "text": "في الكلعسك مقابل ولا حده", "lp": -0.56, "rms": 0.0746, "peak": 0.264}
{"start": 499.24, "end": 501.75, "text": "يبحث عن هذه لاي لترون الدول", "lp": -0.73, "rms": 0.0627, "peak": 0.25}
{"start": 501.96, "end": 503.13, "text": "إسبانيا", "lp": -0.73, "rms": 0.0799, "peak": 0.309}
{"start": 503.24, "end": 509.02, "text": "هذه الاصيلة من سلالة نبلاة هذه العريقة من الاف السنين", "lp": -0.49, "rms": 0.0715, "peak": 0.248}
{"start": 509.1, "end": 515.8, "text": "هذه التي كانت لثماني قرون أرضى أجدادي بفظل رجل اسم عبد الرحمن", "lp": -0.32, "rms": 0.0817, "peak": 0.297}
{"start": 515.85, "end": 517.98, "text": "ادخل فكر قرأيس", "lp": -0.78, "rms": 0.0852, "peak": 0.344}
{"start": 518.18, "end": 519.32, "text": "يارضو تارة", "lp": -1.05, "rms": 0.0756, "peak": 0.267}
{"start": 519.53, "end": 524.47, "text": "هي أرض لندنس هي مدينة خرناة هي قصر الحمراء", "lp": -0.5, "rms": 0.0727, "peak": 0.239}
{"start": 524.49, "end": 529.08, "text": "هي قرطوا تلعي تلاه هي الفلامين كوز سلفة دوري دالي", "lp": -1.15, "rms": 0.0745, "peak": 0.246}
{"start": 529.13, "end": 534.39, "text": "يفعل الملوكية والجمورية", "lp": -1.13, "rms": 0.0707, "peak": 0.237}
{"start": 534.41, "end": 539.22, "text": "الدكتبورية في عدف رنكوه اسبانيا الاربلاهليه", "lp": -0.82, "rms": 0.0787, "peak": 0.281}
{"start": 539.34, "end": 545.82, "text": "هي ذكرية قليلة من طراث عريق لخسته أو لخسته الذكرة في اسماء", "lp": -0.39, "rms": 0.0674, "peak": 0.254}
{"start": 545.9, "end": 547.64, "text": "او اميرك ان او احدد", "lp": -1.14, "rms": 0.0779, "peak": 0.262}
{"start": 547.78, "end": 548.85, "text": "قلوها ده", "lp": -0.92, "rms": 0.0677, "peak": 0.221}
{"start": 548.85, "end": 555.7, "text": "لا يستطيع شيء مميلي كلاسكه يبقى الدس ترجل كورم من كارلس بويول يطلع جي", "lp": -0.83, "rms": 0.0685, "peak": 0.252}
{"start": 555.7, "end": 556.76, "text": "المترجم", "lp": -1.88, "rms": 0.0663, "peak": 0.206}
{"start": 557.13, "end": 563.9, "text": "لقاتر فضفيه العزيمة ويمجد فيه لنتصر عن طريق الكاتد انكارلس بولد", "lp": -0.67, "rms": 0.0711, "peak": 0.247}
{"start": 565.42, "end": 566.36, "text": "يوصط مالعب", "lp": -0.8, "rms": 0.0713, "peak": 0.24}
{"start": 566.57, "end": 567.74, "text": "يلا بالبرسة", "lp": -0.87, "rms": 0.0701, "peak": 0.251}
{"start": 568.55, "end": 569.88, "text": "آنطريك بنسامة", "lp": -1.15, "rms": 0.0782, "peak": 0.26}
{"start": 570.34, "end": 571.9, "text": "في الحياة بليكوان", "lp": -1.24, "rms": 0.0683, "peak": 0.227}
{"start": 572.01, "end": 572.98, "text": "ليلي سابة", "lp": -1.02, "rms": 0.0723, "peak": 0.267}
{"start": 573.58, "end": 575.96, "text": "اخير السعادة كنت فيها بيجوائن", "lp": -0.99, "rms": 0.0719, "peak": 0.245}
{"start": 576.36, "end": 577.3, "text": "درسها القورة", "lp": -0.94, "rms": 0.0764, "peak": 0.26}
{"start": 577.7, "end": 579.64, "text": "بتاكت تبراسل مرسل", "lp": -1.02, "rms": 0.0725, "peak": 0.274}
{"start": 579.78, "end": 585.21, "text": "يورو مرسل ويارب خطة لالحكة مكتولة قورة السطات من برسل يجب", "lp": -0.93, "rms": 0.0745, "peak": 0.257}
{"start": 585.54, "end": 586.81, "text": "ويلار تسوطيني", "lp": -1.4, "rms": 0.0779, "peak": 0.263}
{"start": 587.27, "end": 588.76, "text": "اليوم روزاري", "lp": -0.88, "rms": 0.0773, "peak": 0.257}
{"start": 589.03, "end": 593.04, "text": "في التوقيت ونتلاجة الموارات عدهم الخمسة مسان", "lp": -0.71, "rms": 0.0687, "peak": 0.221}
{"start": 593.04, "end": 598.22, "text": "ومسبت الشو بداة الابداة ولو كان الابداة وراجن", "lp": -0.88, "rms": 0.0768, "peak": 0.26}
{"start": 598.22, "end": 600.41, "text": "لاشكار تويا نسي", "lp": -0.96, "rms": 0.0676, "peak": 0.235}
{"start": 600.9, "end": 602.14, "text": "الكورة ستعود", "lp": -0.66, "rms": 0.085, "peak": 0.278}
{"start": 602.25, "end": 604.73, "text": "من ذرب الزيام الصحيحة البنكو", "lp": -0.66, "rms": 0.0671, "peak": 0.27}
{"start": 604.97, "end": 606.74, "text": "ورسة عود من مستق", "lp": -0.87, "rms": 0.0712, "peak": 0.272}
{"start": 606.86, "end": 611.29, "text": "لم لعب هذا يكون فيومه لا يم تكون سهة بارتلونع", "lp": -0.67, "rms": 0.0677, "peak": 0.232}
{"start": 611.78, "end": 614.94, "text": "يتقدم لتقم البروب بلوغرنا", "lp": -0.91, "rms": 0.0774, "peak": 0.27}
{"start": 615.4, "end": 616.86, "text": "عن طريقة شوي", "lp": -0.92, "rms": 0.074, "peak": 0.271}
{"start": 617.22, "end": 620.18, "text": "أرناندز. والكُرَحَتِرَ التصديد", "lp": -1.26, "rms": 0.0765, "peak": 0.27}
{"start": 620.3, "end": 623.26, "text": "طرحة من قرلس تهم شكورة من المسيوة", "lp": -1.19, "rms": 0.0836, "peak": 0.286}
{"start": 627.62, "end": 634.37, "text": "من الابداء وراجل لشكارتها يا مسي مش ممكرة الرواع اركبنا الكورة فيين", "lp": -0.86, "rms": 0.0501, "peak": 0.166}
{"start": 634.37, "end": 640.43, "text": "والكورة بضغة لي بأخسلونها ابدا ترين تين يلعب وتلعب الكورة كورة تفعدرون", "lp": -0.78, "rms": 0.053, "peak": 0.171}
{"start": 640.43, "end": 645.27, "text": "بادروي سبض دروقنايا ودى القرنبال ودى تلمسيقى", "lp": -0.81, "rms": 0.0472, "peak": 0.163}
{"start": 645.35, "end": 649.56, "text": "بدأ تلاغان المسيطية على الطريقة البارثلونة", "lp": -0.37, "rms": 0.0485, "peak": 0.153}
{"start": 651.21, "end": 652.82, "text": "الرئيس العربوال", "lp": -0.66, "rms": 0.0549, "peak": 0.165}
{"start": 653.06, "end": 655.54, "text": "كان اخذر يوم السبب في البربال", "lp": -0.57, "rms": 0.045, "peak": 0.164}
{"start": 655.66, "end": 661.9, "text": "لكرة من ريال لأنه مدريده الرساة الملوكة الومراء السيوخ", "lp": -0.69, "rms": 0.0464, "peak": 0.156}
{"start": 661.9, "end": 668.21, "text": "تتابع الكما بكل التحمس بكل العلاق الوطيد للعرب", "lp": -0.44, "rms": 0.0479, "peak": 0.162}
{"start": 668.21, "end": 673.24, "text": "مع برسة و مع مدريد دس في داخلاء لكن مرة السلام", "lp": -0.61, "rms": 0.0447, "peak": 0.153}
{"start": 673.29, "end": 679.93, "text": "مرة السلامات لا نستسلام اللي لا يمدريد اللون العبية وانوان السلام", "lp": -0.5, "rms": 0.0445, "peak": 0.156}
{"start": 679.98, "end": 685.15, "text": "لبنك اليوم عنوان استسلام شف القورة ونركنا شف ونحطها", "lp": -0.56, "rms": 0.0442, "peak": 0.152}
{"start": 685.15, "end": 691.7, "text": "شوفوا حتى المزلون شوفوا حتى الولهان بكرة القدم الله على الثامنا هدفو", "lp": -0.46, "rms": 0.0438, "peak": 0.149}
{"start": 691.7, "end": 695.9, "text": "كان قريب ولكن القفاز الزابي لكسيس", "lp": -0.7, "rms": 0.0468, "peak": 0.168}
{"start": 695.91, "end": 702.8, "text": "يرقب كورة تصد وتنوب عنه تذود عنه الوان الريال القائم", "lp": -0.34, "rms": 0.0445, "peak": 0.157}
{"start": 702.8, "end": 706.07, "text": "لبك العارض اليوم نقسيا", "lp": -0.84, "rms": 0.0445, "peak": 0.158}
{"start": 706.44, "end": 707.7, "text": "go what i'm a saint", "lp": -1.14, "rms": 0.0418, "peak": 0.167}
{"start": 707.88, "end": 709.18, "text": "في السطة قائق", "lp": -0.77, "rms": 0.041, "peak": 0.147}
{"start": 709.48, "end": 711.06, "text": "تلسة قورات في المارمة", "lp": -0.94, "rms": 0.0367, "peak": 0.141}
{"start": 711.46, "end": 717.18, "text": "مرينه مسالي سخن توارد يول على ذكريات وذكريات", "lp": -0.62, "rms": 0.0482, "peak": 0.166}
