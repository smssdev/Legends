APP_NAME=GLM
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Where the web app runs, for the links in emails
FRONTEND_URL=http://localhost:5173

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Defaults: database/legends.sqlite, database/cache.sqlite, database/queue.sqlite
# DB_DATABASE=
# DB_CACHE_DATABASE=
# DB_QUEUE_DATABASE=
DB_BUSY_TIMEOUT=5000

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Reverb: the live broadcast server (free, part of Laravel). `composer dev` starts it on 8080.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=legends
REVERB_APP_KEY=legends-dev-key
REVERB_APP_SECRET=legends-dev-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# The developers' fixed accounts [X11]: each Gmail, once confirmed, takes Owner-Hamza or Owner-Soliman and the admin panel.
OWNER_HAMZA_EMAIL=
OWNER_SOLIMAN_EMAIL=

# Support buttons [X13]: the WhatsApp number in international form and the Telegram username.
SUPPORT_WHATSAPP=
SUPPORT_TELEGRAM=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="الأساطير"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# Google sign-in (free Google Cloud project). Empty: the Google button says it is not set up.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
# The Android app's client ids, comma separated (Sprint 41)
GOOGLE_ANDROID_CLIENT_IDS=

# The nightly engine calibration (docs/ENGINE.md 9): on for the home server only.
GAME_NIGHTLY_BALANCE=false

# Phone alerts when a server service stops (ntfy, free): each phone subscribes to this topic in the ntfy app.
# setup.ps1 makes one on the home server. Empty: the health check runs without alerts.
NTFY_TOPIC=

# Web Push for the game's notifications (Sprint 36): php artisan push:keys, once.
WEBPUSH_VAPID_PUBLIC=
WEBPUSH_VAPID_PRIVATE=
WEBPUSH_SUBJECT=mailto:admin@legends.local

# Sprint 37: the second disk for Litestream's continuous copy, and the rclone remote for the daily copy on Google Drive.
LITESTREAM_REPLICA_DIR=
BACKUP_RCLONE_REMOTE=
