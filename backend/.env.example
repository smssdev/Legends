APP_NAME=GLM
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Where the web app runs, for the links in emails
FRONTEND_URL=http://localhost:5173

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# Defaults: database/legends.sqlite, database/cache.sqlite, database/queue.sqlite
# DB_DATABASE=
# DB_CACHE_DATABASE=
# DB_QUEUE_DATABASE=
DB_BUSY_TIMEOUT=5000

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Reverb: the live broadcast server (free, part of Laravel). `composer dev` starts it on 8080.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=legends
REVERB_APP_KEY=legends-dev-key
REVERB_APP_SECRET=legends-dev-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# The developers' fixed accounts [X11]: each Gmail, once confirmed, takes Owner-Hamza or Owner-Soliman and the admin panel.
OWNER_HAMZA_EMAIL=
OWNER_SOLIMAN_EMAIL=

# Support buttons [X13]: the WhatsApp number in international form and the Telegram username.
SUPPORT_WHATSAPP=
SUPPORT_TELEGRAM=

# [X57] Google AdSense: the account's publisher id (ca-pub-…), a display ad unit's id, and the rewarded videos (H5 Games
# Ads) with Google's test ads until they approve the site. Empty: no Google ads, only the game's own.
ADSENSE_CLIENT=
ADSENSE_SLOT=
ADSENSE_REWARDED=false
ADSENSE_TEST=false

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="game.legend.manager@gmail.com"
MAIL_FROM_NAME="Game Legend Manager"
# [Sprint 39 M1] On the server: the game's Gmail (deploy/docker/start.sh), with its app password set by legends-set
# GMAIL_APP_PASSWORD (Google account, Security, 2-Step Verification, App passwords). Never in the repository.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# Google sign-in (free Google Cloud project). Empty: the Google button says it is not set up.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
# The Android app's client ids, comma separated (Sprint 41)
GOOGLE_ANDROID_CLIENT_IDS=

# The Assistant Coach's mind (Sprint 22): a free Gemini key from Google AI Studio, written on the server with
# legends-set GEMINI_API_KEY. Empty: the assistant answers from the game's guide. The models, tried in order.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite
# [Sprint 67] The game's bots, official and free. Telegram: legends-set TELEGRAM_BOT_TOKEN and TELEGRAM_WEBHOOK_SECRET,
# then `php artisan messenger:setup`. WhatsApp (Meta Cloud API): legends-set WHATSAPP_TOKEN, WHATSAPP_PHONE_ID,
# WHATSAPP_APP_SECRET and WHATSAPP_VERIFY_TOKEN. Empty: that bot is off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=GameLegendManagerBot
TELEGRAM_CHANNEL=
TELEGRAM_CHANNEL_URL=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_NUMBER=
WHATSAPP_CHANNEL_URL=

# The nightly engine calibration (docs/ENGINE.md 9): on for the home server only.
GAME_NIGHTLY_BALANCE=false

# Phone alerts when a server service stops (ntfy, free): each phone subscribes to this topic in the ntfy app.
# setup.ps1 makes one on the home server. Empty: the health check runs without alerts.
NTFY_TOPIC=

# Web Push for the game's notifications (Sprint 36): php artisan push:keys, once.
WEBPUSH_VAPID_PUBLIC=
WEBPUSH_VAPID_PRIVATE=
WEBPUSH_SUBJECT=mailto:admin@legends.local
# [Sprint 19] The Android app's pushes: the service account's JSON file (a path on the server, secret) and the app's
# Firebase settings (not secret). Empty: no app pushes.
FCM_CREDENTIALS=
FIREBASE_API_KEY=
FIREBASE_ANDROID_APP_ID=
FIREBASE_PROJECT_ID=
FIREBASE_SENDER_ID=

# Sprint 37: the second disk for Litestream's continuous copy, and the rclone remote for the daily copy on Google Drive.
LITESTREAM_REPLICA_DIR=
BACKUP_RCLONE_REMOTE=
