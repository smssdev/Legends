{
  "$comment": "Legends design tokens: the single source for Tailwind (web/) and Flutter ThemeData (mobile/). Values come from the design system board (legends-ui/Main.dc.html). Change here first, then regenerate both.",
  "color": {
    "bg": "#0A1F42",
    "bgDeep": "#071733",
    "surface": "#10284F",
    "surfaceSunk": "#0D2348",
    "surfaceRaised": "#163360",
    "gold": "#F5B82E",
    "goldDark": "#C08A0C",
    "goldLight": "#FFD36B",
    "pitch": "#1E9E4A",
    "pitchDark": "#1A8A42",
    "text": "#F7F4EA",
    "textMuted": "#A9B6CC",
    "textSoft": "#C9D2E1",
    "live": "#EF4444",
    "warning": "#F2994A",
    "success": "#2BB673",
    "onGold": "#0A1F42"
  },
  "line": {
    "gk": { "bg": "#F5B82E", "fg": "#0A1F42" },
    "def": { "bg": "#2F6FDB", "fg": "#FFFFFF" },
    "mid": { "bg": "#1E9E4A", "fg": "#FFFFFF" },
    "att": { "bg": "#F2994A", "fg": "#2A1300" }
  },
  "fitness": {
    "high": { "min": 75, "color": "#2BB673" },
    "mid": { "min": 60, "color": "#F5B82E" },
    "low": { "min": 0, "color": "#F2994A" }
  },
  "rating": [
    { "min": 8, "bg": "#1E9E4A", "fg": "#FFFFFF" },
    { "min": 7, "bg": "#5FB85A", "fg": "#0A1F42" },
    { "min": 6, "bg": "#F5B82E", "fg": "#0A1F42" },
    { "min": 0, "bg": "#F2994A", "fg": "#2A1300" }
  ],
  "font": {
    "display": { "family": "Alexandria", "weights": [500, 700, 800] },
    "body": { "family": "IBM Plex Sans Arabic", "weights": [400, 500, 600] },
    "numbers": { "family": "Barlow Condensed", "weights": [600, 700] },
    "$license": "All three are SIL Open Font License: bundled as files in the Flutter app and served by Google Fonts on the web."
  },
  "size": {
    "touchMin": 44,
    "radius": { "sm": 8, "md": 12, "lg": 14, "xl": 20, "xxl": 24, "pill": 999 },
    "space": [4, 6, 8, 10, 12, 14, 16, 18, 20, 24, 28]
  },
  "match": {
    "tickMs": 3000,
    "extraTimeTickMs": 2000,
    "halftimeSeconds": 30,
    "introSeconds": 8,
    "homeSide": "right",
    "$homeSide": "RTL: the home team sits on the right of the score bug, so the score string reads away-home left to right."
  }
}
