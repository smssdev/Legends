{
  // GitHub Codespaces: Code > Codespaces > Create codespace on this branch.
  // When it finishes setting up, the simulator opens on port 8000.
  "name": "Legends",
  "image": "mcr.microsoft.com/devcontainers/php:1-8.4-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },
  "containerEnv": { "SIMULATOR_ENABLED": "true" },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postAttachCommand": "bash .devcontainer/start.sh",
  "forwardPorts": [8000, 5173],
  "portsAttributes": {
    "8000": { "label": "Legends (built app + API)", "onAutoForward": "openBrowser" },
    "5173": { "label": "Vite dev server" }
  },
  // Optional Codespaces secrets (github.com/settings/codespaces), read by .devcontainer/env.sh.
  "secrets": {
    "GMAIL_ADDRESS": { "description": "The Gmail address that sends the game's emails (confirmation, password reset)." },
    "GMAIL_APP_PASSWORD": { "description": "An app password for that Gmail (myaccount.google.com/apppasswords), not the Gmail password." },
    "GOOGLE_CLIENT_ID": { "description": "Google sign-in: the OAuth web client id from console.cloud.google.com." },
    "GOOGLE_CLIENT_SECRET": { "description": "Google sign-in: that client's secret." }
  },
  "customizations": {
    "codespaces": { "openFiles": ["docs/DONE.md"] },
    "vscode": { "extensions": ["Vue.volar", "bmewburn.vscode-intelephense-client", "bradlc.vscode-tailwindcss"] }
  }
}
